{
  // Versión del esquema del archivo de manifiesto.
  "version": 1,
  // Indica que este es el archivo raíz. Detiene la búsqueda de otros manifiestos en carpetas superiores.
  "isRoot": true,
  // Listado de herramientas específicas para este proyecto.
  "tools": {
    // Herramienta para configurar la plataforma de identidad de Microsoft (Entra ID / Azure AD).
    "microsoft.dotnet-msidentity": {
      // Versión exacta de la herramienta que se debe instalar.
      "version": "2.0.8",
      // Lista de comandos disponibles para ejecutar mediante "dotnet <comando>".
      "commands": [
        "dotnet-msidentity"
      ],
      // Si es 'false', la herramienta no intentará usar versiones más nuevas del runtime de .NET
      // si la versión para la que fue compilada no está presente.
      "rollForward": false
    }
  }
}