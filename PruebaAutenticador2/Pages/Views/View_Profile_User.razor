@page "/home/verPerfil"
@attribute [Authorize]
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@using PruebaAutenticador2.Services
@using PruebaAutenticador2.Shared.DTOS.Usuarios
@inject UsuarioApiService UsuarioApiService
@using PruebaAutenticador2.Classes
@using System.Net

<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Form_Profile.css" />

<PageTitle>Perfil del usuario</PageTitle>

<Div Class="view-profile-page">
    <Div Class="left-section">
        <Div class="image-left">
            <img src="https://cdn.pixabay.com/photo/2017/11/10/05/48/user-2935527_1280.png" alt="Imagen circular" />
        </Div>
    </Div>

    <Div Class="right-section">
        <Container Class="container-form">
            <Form>
                <fieldset>
                    <Field Class="mb-3">
                        <FieldLabel For="nombreUsuario">Nombre del usuario</FieldLabel>
                        <TextEdit Class="form-control" Text="@currentUser.NombreUsuario" ReadOnly="true" ElementId="nombreUsuario" />
                    </Field>
                    <Field Class="mb-3">
                        <FieldLabel For="correcoInstitucional">Correo institucional</FieldLabel>
                        <TextEdit Class="form-control" Text="@currentUser.CorreoInstitucional" ReadOnly="true" ElementId="correcoInstitucional" />
                    </Field>
                    <Field Class="mb-3">
                        <FieldLabel For="tipoDeUsuario">Tipo de usuario</FieldLabel>
                        <TextEdit Class="form-control" Text="@currentUser.TipoUsuario" ReadOnly="true" ElementId="tipoDeUsuario" />
                    </Field>
                    <Field Class="mb-3">
                        <FieldLabel For="rolAsociado">Rol asociado</FieldLabel>
                        <TextEdit Class="form-control" Text="@currentUser.Rol" ReadOnly="true" ElementId="rolAsociado" />
                    </Field>
                    <Field Class="mb-3">
                        <FieldLabel For="facultadAsociada">Facultad asociada</FieldLabel>
                        <TextEdit Class="form-control" Text="@currentUser.Facultad" ReadOnly="true" ElementId="facultadAsociada" />
                    </Field>
                    <Field Class="mb-3">
                        <FieldLabel For="carreraAsociada">Carrera asociada</FieldLabel>
                        <TextEdit Class="form-control" Text="@currentUser.Carrera" ReadOnly="true" ElementId="carreraAsociada" />
                    </Field>
                    <Div Class="text-center">
                        <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Clicked="goBack">Regresar</Button>
                    </Div>
                </fieldset>
            </Form>
        </Container>
    </Div>
</Div>

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>


@code {

    private UsuarioDto currentUser = new();

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    //Este método se ejecuta al inicializar el componente y obtiene el correo del usuario únicamente
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            NavManager.NavigateTo("/");
            return;
        }

        // Claim más común
        var email = user.FindFirst("preferred_username")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        if (string.IsNullOrEmpty(email))
        {
            NavManager.NavigateTo("/usuario-no-encontrado");
            return;
        }

        await LoadUserProfile(email);
    }

    private async Task LoadUserProfile(string email)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var emailUser = await UsuarioApiService.GetByEmailAsync(email);

            if (!emailUser.Success)
            {
                switch (emailUser.StatusCode)
                {
                    case HttpStatusCode.NotFound:
                        errorMessage = emailUser.ErrorMessage;
                        await modalToShowErrorMessage.Show();
                        break;

                    default:
                        errorMessage = emailUser.ErrorMessage;
                        await modalToShowErrorMessage.Show();
                        break;
                }

                return;
            }

            currentUser = emailUser.Data!;

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void goBack()
    {
        // Cancelar cambios y regresar a la pantalla principal 
        NavManager.NavigateTo("/home");
    }

    private Task HideModal(Modal modal)
    {
        NavManager.NavigateTo("/home");
        return modal.Hide();
    }

   

}