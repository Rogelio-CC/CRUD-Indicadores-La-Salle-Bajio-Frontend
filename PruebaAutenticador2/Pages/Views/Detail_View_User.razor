@page "/home/vistaUsuarios/detalleUsuario/{userId:guid}"
@attribute [Authorize]
@inject NavigationManager NavManager
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@inject UsuarioApiService UsuarioApiService
@inject AuthStateService AuthState
@using System.Net

<link rel="stylesheet" href="css/DetailV.css" />
<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/Footer.css" />
<link rel="stylesheet" href="css/Fonts.css" />

<PageTitle>Detalle del usuario</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Detalles del usuario</h1>

<Divider Class="separate-line-detail" />

<Div Class="container-detail">
    <Form>
        <fieldset class="form-grid">
            <!-- Fila 1 -->
            <Field Class="form-field">
                <FieldLabel For="nombreUsuario">Nombre del usuario</FieldLabel> 
                <TextEdit Class="form-control" Text="@currentUser.NombreUsuario" ReadOnly="true" ElementId="nombreUsuario"/>
            </Field>
            <Field Class="form-field">
                <FieldLabel For="correcoInstitucional">Correo institucional</FieldLabel>
                <TextEdit Class="form-control" Text="@currentUser.CorreoInstitucional" ReadOnly="true" ElementId="correcoInstitucional" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="tipoDeUsuario">Tipo de usuario</FieldLabel>
                <TextEdit Class="form-control" Text="@currentUser.TipoUsuario" ReadOnly="true" ElementId="tipoDeUsuario" />
            </Field>

            <!-- Fila 2 -->
            <Field Class="form-field">
                <FieldLabel For="rolAsociado">Rol asociado</FieldLabel>
                <TextEdit Class="form-control" Text="@currentUser.Rol" ReadOnly="true" ElementId="rolAsociado" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="facultadAsociada">Facultad asociada</FieldLabel>
                <TextEdit Class="form-control" Text="@currentUser.Facultad" ReadOnly="true" ElementId="facultadAsociada"/>
            </Field>
            <Field Class="form-field">
                <FieldLabel For="carreraAsociada">Carrera asociada</FieldLabel>
                <TextEdit Class="form-control" Text="@currentUser.Carrera" ReadOnly="true" ElementId="carreraAsociada"/>
            </Field>
        </fieldset>
    </Form>
   
    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                       background-color: #002855;
                       color: #ffffff;
                       width:96%;
                       box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                       text-transform: uppercase;"
                Clicked="goBack">
            Regresar
        </Button>
    </Div>
</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>


@code {
    [Parameter]
    public Guid? userId { get; set; }

    private User currentUser = new();

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (userId is not null && userId != Guid.Empty)
            {
                var responseToGetId = await UsuarioApiService.GetByIdAsync(userId.Value);

                if (!responseToGetId.Success)
                {
                    switch (responseToGetId.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;
                    }

                    return;
                }

                var dto = responseToGetId.Data;

                currentUser = new User
                {
                    Id = dto!.Id,
                    NombreUsuario = dto.NombreUsuario,
                    CorreoInstitucional = dto.CorreoInstitucional,
                    TipoUsuario = dto.TipoUsuario,
                    RolId = dto.RolId,
                    Rol = dto.Rol,
                    FacultadId = dto.FacultadId,
                    Facultad = dto.Facultad,
                    CarreraId = dto.CarreraId,
                    Carrera = dto.Carrera,


                };

            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaUsuarios");

    }

    private Task HideModal(Modal modal)
    {
        NavManager.NavigateTo("/home/vistaUsuarios");
        return modal.Hide();
    }
}
