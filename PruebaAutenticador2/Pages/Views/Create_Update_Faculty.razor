<!-- La estructura .razor de CreateUpdateFaculty es la misma que CreateUpdateActivity,  por lo que se reutiliza varias partes de código de esa vista para esta.-->
<!-- También se reutiliza el código para subir un archivo de políticas como las evidencias en CreateUpdateIndicator. -->
@page "/home/vistaFacultades/creacionFacultad"
@page "/home/vistaFacultades/creacionFacultad/{facultyId:guid}"
@attribute [Authorize]

@inject NavigationManager NavManager
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@inject FacultadApiService FacultadApiService
@using System.ComponentModel.DataAnnotations
@inject AuthStateService AuthState
@using System.Net
@inject ArchivoPoliticasApiService ArchivoPoliticasApiService

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/AllForms.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />
<link rel="stylesheet" href="css/ViewPolicyFile.css" />

<PageTitle>@pageTitle</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Facultad</h1>

<Divider Class="separate-line-register" />

<Div Class="container-register">
    <Form>
        <fieldset class="form-grid">
            <Validations @ref="validations" Mode="ValidationMode.Auto" Model="currentFaculty">
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="nombreFacultad">Nombre de la facultad</FieldLabel>
                        <TextEdit Class="form-control" ElementId="nombreFacultad" @bind-Text=currentFaculty.Nombre />
                    </Field>
                </Validation>
                <Field Class="form-field">
                    <FieldLabel For="slogan">Slogan</FieldLabel>
                    <TextEdit Class="form-control" ElementId="slogan" @bind-Text=currentFaculty.Slogan />
                </Field>
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="mision">Misión</FieldLabel>
                        <MemoEdit Rows="5" ReplaceTab TabSize="4" Class="form-control" ElementId="mision" @bind-Text=currentFaculty.Mision />
                    </Field>
                </Validation>
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="vision">Visión</FieldLabel>
                        <MemoEdit Rows="5" ReplaceTab TabSize="4" Class="form-control" ElementId="vision" @bind-Text=currentFaculty.Vision />
                    </Field>
                </Validation>
                @if(currentFaculty.Id != Guid.Empty)
                {
                    <Field Class="form-field">
                        <!-- El input se bloquea cuando detecta que ya se subio un archivo temporal. -->
                        <FieldLabel for="nuevoArchivoPoliticas">Adjuntar archivo de políticas en formato PDF</FieldLabel>
                        <FileEdit Changed="@OnFilesChanged" Disabled="@(archivoPoliticasTemp != null && archivoPoliticasTemp.Any(x => !x.MarcarArchivoParaEliminar))" Class="form-control" ElementId="nuevoArchivoPoliticas" />
                        @if (archivoPoliticasTemp != null && archivoPoliticasTemp.Any(x => !x.MarcarArchivoParaEliminar))
                        {
                            <div class="text-muted mt-1" style="font-size: 0.85rem; font-family:IndivisaFontBold">
                                Debe eliminar el archivo actual para subir uno nuevo.
                            </div>
                        }
                    </Field>
                    <Field Class="container-archivo">
                        <FieldLabel Class="label-archivo" For="archivo">Archivo</FieldLabel>
                        @if (archivoPoliticasTemp.Any())
                        {
                            <ul class="list-archivo">
                                @foreach (var e in archivoPoliticasTemp.Where(x => !x.MarcarArchivoParaEliminar))
                                {
                                    <li class="item-archivo @(e.EsNuevoArchivo ? "temporal" : "")">
                                        <span class="nombreArchivo">@e.NombreArchivo</span>

                                        @if (e.EsNuevoArchivo)
                                        {
                                            <span class="tipo-archivo">(pendiente de guardar)</span>
                                        }

                                        <Button Clicked="() => confirmDelete(e)">Eliminar</Button>
                                    </li>
                                }

                            </ul>
                        }
                    </Field>
                }
            </Validations>
        </fieldset>
    </Form>

    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                       background-color: #002855;
                       color: #ffffff;
                       width:50%;
                       box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                       text-transform: uppercase;"
               Clicked="submit">
            @buttonText
        </Button>
        <Button Style="font-family:IndivisaFont;
                       background-color: #002855;
                       color: #ffffff;
                       width:50%;
                       box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                       text-transform: uppercase;"
                Clicked="goBack">
            Cancelar
        </Button>
    </Div>

</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, false)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessageAndRedirectViewPage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, true)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="modalRefByDeleteFile">
    <ModalContent Centered>
        <ModalHeader Style="background-color: #002855;">
            <ModalTitle Style="font-family:IndivisaFontBold; color: #ffffff;">Eliminación del archivo de políticas</ModalTitle>
            <CloseButton Style="background-color: #ffffff; opacity: 1;" />
        </ModalHeader>
        <ModalBody>
            <Field>
                <FieldLabel Style="font-family:IndivisaFont;">¿Quieres eliminar este archivo? Cuando se presione el botón "Actualizar", se borrará permanentemente.</FieldLabel>
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Clicked="() => HideModal(modalRefByDeleteFile, false)">No</Button>
            <Button Style="font-family:IndivisaFont; background-color: #CF152D; color: #ffffff;" Clicked="@RemoveEvidence">Si</Button>
        </ModalFooter>
    </ModalContent>
</Modal>


@code {
    // La estructura de CreateUpdateFaculty es la misma que CreateUpdateActivity, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    [Parameter]
    public Guid? facultyId { get; set; }

    private Faculty currentFaculty = new();
    private List<ArchivoPoliticasTemporal> archivoPoliticasTemp = new();
    private ArchivoPoliticasTemporal archivoPoliticasT;
    private string pageTitle = "Crear facultad";
    private string buttonText = "Crear";

    private Validations validations;

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    private Modal modalToShowErrorMessageAndRedirectViewPage;

    private Modal modalRefByDeleteFile;



    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (facultyId is not null && facultyId != Guid.Empty)
            {
                var facultyFromApi = await FacultadApiService.GetByIdAsync(facultyId.Value);

                if (!facultyFromApi.Success)
                {
                    switch (facultyFromApi.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = facultyFromApi.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();

                            break;

                        default:
                            errorMessage = facultyFromApi.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                if (facultyFromApi != null)
                {
                    currentFaculty = facultyFromApi.Data!;
                    pageTitle = "Editar facultad";
                    buttonText = "Actualizar";
                }

                //Se carga el archivo de las políticas.
                await LoadFile();
            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessageAndRedirectViewPage.Show();
        } 
        finally
        {
            isLoading = false;
        }
    }

    private async Task submit()
    {
        if (await validations.ValidateAll())
        {
            await saveFaculty();
        }
    }

    private async Task saveFaculty()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (facultyId is null || facultyId == Guid.Empty)
            {
                var response = await FacultadApiService.CreateAsync(currentFaculty);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = "Los campos de la facultad no deben quedar vacios (excepto slogan). Además, el nombre deben tener al menos 5 caracteres y no debe superar los 100 caracteres, mientras que la misión y la visión de la facultad no debe superar los 1000 caracteres.";
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                currentFaculty.Id = response.Data!.Id;

            }
            else
            {
                var response = await FacultadApiService.UpdateAsync(currentFaculty.Id, currentFaculty);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = "Los campos de la facultad no deben quedar vacios (excepto slogan). Además, el nombre deben tener al menos 5 caracteres y no debe superar los 100 caracteres, mientras que la misión y la visión de la facultad no debe superar los 1000 caracteres. También puede ser que el ID no coincida.";
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.NotFound:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                foreach (var e in archivoPoliticasTemp.Where(x => x.MarcarArchivoParaEliminar && !x.EsNuevoArchivo))
                {
                    var responseToDeleteFile = await ArchivoPoliticasApiService.DeleteAsync(currentFaculty.Id, e.Id!.Value);

                    if (!responseToDeleteFile.Success)
                    {
                        switch (responseToDeleteFile.StatusCode)
                        {
                            case HttpStatusCode.NotFound:
                                errorMessage = responseToDeleteFile.ErrorMessage;
                                await modalToShowErrorMessageAndRedirectViewPage.Show();
                                break;

                            default:
                                errorMessage = responseToDeleteFile.ErrorMessage;
                                await modalToShowErrorMessageAndRedirectViewPage.Show();
                                break;
                        }

                        return;
                    }
                }

                foreach (var e in archivoPoliticasTemp.Where(x => x.EsNuevoArchivo))
                {
                    var responseToUploadFile = await ArchivoPoliticasApiService.UploadAsync(currentFaculty.Id, e.file!);

                    if (!responseToUploadFile.Success)
                    {
                        switch (responseToUploadFile.StatusCode)
                        {
                            case HttpStatusCode.BadRequest:
                                errorMessage = responseToUploadFile.ErrorMessage;
                                await modalToShowErrorMessage.Show();
                                break;

                            default:
                                errorMessage = responseToUploadFile.ErrorMessage;
                                await modalToShowErrorMessageAndRedirectViewPage.Show();
                                break;
                        }

                        return;
                    }
                }
            }

            NavManager.NavigateTo("/home/vistaFacultades");
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task LoadFile()
    {
        var archivoReal = await ArchivoPoliticasApiService.GetByFacultyIdAsync(currentFaculty.Id);

        if (!archivoReal.Success)
        {
            errorMessage = archivoReal.ErrorMessage;
            modalToShowErrorMessage?.Show();
            return;
        }

        archivoPoliticasTemp = archivoReal.Data!.Select(e => new ArchivoPoliticasTemporal
        {
            Id = e.Id,
            NombreArchivo = e.NombreArchivo,
            Tipo = e.Tipo,
            EsNuevoArchivo = false,
            MarcarArchivoParaEliminar = false
        }).ToList();
    }

    private async Task OnFilesChanged(FileChangedEventArgs e)
    {
        foreach (var file in e.Files)
        {
            archivoPoliticasTemp.Add(new ArchivoPoliticasTemporal
            {
                Id = null,
                NombreArchivo = file.Name,
                Tipo = file.Type,
                EsNuevoArchivo = true,
                file = file
            });
        }
    }

    private void RemoveEvidence()
    {
        if (archivoPoliticasT.EsNuevoArchivo)
        {
            archivoPoliticasTemp.Remove(archivoPoliticasT);
        }
        else
        {
            archivoPoliticasT.MarcarArchivoParaEliminar = true;
        }

        HideModal(modalRefByDeleteFile, false);
    }

    private Task confirmDelete(ArchivoPoliticasTemporal archivoPT)
    {
        archivoPoliticasT = archivoPT;
        return modalRefByDeleteFile.Show();
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaFacultades");
    }

    private Task HideModal(Modal modal, bool value)
    {
        if (value)
        {
            NavManager.NavigateTo("/home/vistaFacultades");
            return modal.Hide();
        }
        else
        {
            return modal.Hide();
        }
    }
}
