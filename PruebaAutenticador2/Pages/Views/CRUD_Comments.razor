<!-- La estructura .razor de CRUDComments es la misma que CRUDActivities,  por lo que se reutiliza varias partes de código de esa vista para esta.-->
@page "/home/vistaComentarios"
@attribute [Authorize]

@inject NavigationManager NavManager
@inject ComentarioApiService ComentarioApiService
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@using PruebaAutenticador2.Shared.DTOS.Comentario
@inject AuthStateService AuthState

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/Tables.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<PageTitle>Lista de comentarios</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<Div Class="header-section">
    <h1 class="title-general">Lista de comentarios</h1>
    <Div Class="header-buttons">
        <Button Class="add-button" Clicked="@addComment">
            Agregar comentario
        </Button>
        <Button Class="add-button" Clicked="@goBack">
            Regresar al inicio
        </Button>
    </Div>
</Div>

<Divider Class="separate-line" />

<Div Class="search-container">
    <Span Class="search-icon">
        <i class="fas fa-search"></i>
    </Span>
    <TextEdit Placeholder="Busca por creador" Class="search-bar" Text="@searchText" TextChanged="@OnSearchChanged" />
</Div>

<Div Class="table-container">
    <Table Bordered ResponsiveMode="TableResponsiveMode.Mobile" align="left" Class="all-table">
        <TableHeader>
            <TableRow>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Creador asociado
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Contenido
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Fecha de creación
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Acciones
                </TableHeaderCell>
            </TableRow>
        </TableHeader>
        <TableBody>
            @foreach (var comment in filteredComments)
            {
                <TableRow>
                    <TableRowCell MobileModeCaption="Creador asociado">@comment.Creador</TableRowCell>
                    <TableRowCell MobileModeCaption="Contenido">@comment.Contenido</TableRowCell>
                    <TableRowCell MobileModeCaption="Fecha de creación">@comment.FechaComentario.ToString("dd/MM/yyyy")</TableRowCell>
                    <TableRowCell>
                        <Div Class="buttons-container">
                            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Clicked="() => viewComment(comment.Id)">
                                Detalles
                            </Button>
                            @if (CanEditOrDelete(comment.CreadorId))
                            {
                                <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-left: 15px;" Clicked="() => editComment(comment.Id)">
                                    Editar
                                </Button>
                                <Button Style="font-family:IndivisaFont; background-color: #CF152D; color: #ffffff; margin-left: 15px;" Clicked="() => confirmDelete(comment.Id)">
                                    Eliminar
                                </Button>
                            }
                        </Div>
                    </TableRowCell>
                </TableRow>
            }
        </TableBody>
    </Table>
</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}


<Modal @ref="modalRef">
    <ModalContent Centered>
        <ModalHeader Style="background-color: #002855;">
            <ModalTitle Style="font-family:IndivisaFontBold; color: #ffffff;">Eliminación de un comentario</ModalTitle>
            <CloseButton Style="background-color: #ffffff; opacity: 1;" />
        </ModalHeader>
        <ModalBody>
            <Field>
                <FieldLabel Style="font-family:IndivisaFont;">¿Quieres eliminar este comentario?</FieldLabel>
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Clicked="() => HideModal(modalRef)">No</Button>
            <Button Style="font-family:IndivisaFont; background-color: #CF152D; color: #ffffff;" Clicked="@deleteComment">Si</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>


@code {
    // La estructura de CRUDComments es la misma que CRUDActivities, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    private List<ComentarioDto> commentList = new();

    private string searchText = string.Empty;
    private List<ComentarioDto> filteredComments = new();

    private bool isLoading = false;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadComments();
    }

    private async Task LoadComments()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await ComentarioApiService.GetAllAsync();

            commentList = response.Data!.OrderBy(r => r.Creador).ToList();

            filteredComments = commentList;

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }

    }

    private void OnSearchChanged(string value)
    {
        searchText = value;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredComments = commentList;
        }
        else
        {
            filteredComments = commentList
                .Where(a =>
                    a.Creador.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private bool CanEditOrDelete(Guid creadorId)
    {
        if (AuthState.Role == "Administrador") return true;

        if (AuthState.IdUser == null) return false;

        return creadorId.ToString() == AuthState.IdUser;
    }

    private void addComment()
    {
        NavManager.NavigateTo("/home/vistaComentarios/creacionComentario");
    }

    private Guid commentToDelete;

    private void viewComment(Guid id)
    {
        NavManager.NavigateTo($"/home/vistaComentarios/detalleComentario/{id}");
    }

    private void editComment(Guid id)
    {
        NavManager.NavigateTo($"/home/vistaComentarios/creacionComentario/{id}");
    }

    private Task confirmDelete(Guid id)
    {
        commentToDelete = id;
        return modalRef.Show();
    }

    private async Task deleteComment()
    {
        var response = await ComentarioApiService.DeleteAsync(commentToDelete);

        if (!response.Success)
        {
            errorMessage = response.ErrorMessage ?? "No se pudo eliminar el comentario";
            modalToShowErrorMessage?.Show();
            return;
        }

        await LoadComments();
        await modalRef.Hide();
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home");
    }

    private Modal modalRef;
    private Modal modalToShowErrorMessage;

    private Task HideModal(Modal modal)
    {
        return modal.Hide();
    }

}

