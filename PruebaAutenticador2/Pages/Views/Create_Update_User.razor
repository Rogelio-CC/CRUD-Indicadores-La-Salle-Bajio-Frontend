<!-- La estructura .razor de CreateUpdateUser es la misma que CreateUpdateActivity,  por lo que se reutiliza varias partes de código de esa vista para esta. -->
@page "/home/vistaUsuarios/creacionUsuario"
@page "/home/vistaUsuarios/creacionUsuario/{userId:guid}"
@attribute [Authorize]

@inject NavigationManager NavManager
@inject UsuarioApiService UsuarioApiService
@inject FacultadApiService FacultadApiService
@inject CarreraApiService CarreraApiService
@inject RoleApiService RoleApiService
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@using System.ComponentModel.DataAnnotations
@using PruebaAutenticador2.Shared.DTOS.Usuarios;
@using PruebaAutenticador2.Shared.DTOS.ListaCombos;
@inject AuthStateService AuthState
@using System.Net

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/AllForms.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<PageTitle>@pageTitle</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Usuario</h1>

<Divider Class="separate-line-register" />

<Div Class="container-register">
    <Form>
        <fieldset class="form-grid">
            <Validations @ref="validations" Mode="ValidationMode.Auto" Model="currentUser">
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="nombreUsuario">Nombre del usuario</FieldLabel>
                        <TextEdit Class="form-control" @bind-Text=currentUser.NombreUsuario ElementId="nombreUsuario" />
                    </Field>
                </Validation>
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="carreraAsociada">Carrera asociada</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="carreraAsociada" @bind-SelectedValue=currentUser.CarreraId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var c in carreras)
                            {
                                <SelectItem TValue="Guid" Value="@c.Id">
                                    @c.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
                <Validation Validator="ValidationRule.IsEmail">
                    <Field Class="form-field">
                        <FieldLabel For="correoInstitucional">Correo institucional</FieldLabel>
                        <TextEdit Class="form-control" @bind-Text=currentUser.CorreoInstitucional ElementId="correoInstitucional" />
                    </Field>
                </Validation>
                <Validation Validator="ValidationRule.IsSelected">
                    <Field Class="form-field">
                        <FieldLabel For="tipoUsuario">Tipo de usuario</FieldLabel>
                        <Select Class="form-select" TValue="string" ElementId="tipoUsuario" @bind-SelectedValue=currentUser.TipoUsuario>
                            <SelectItem TValue="string" Value="string.Empty">Selecciona alguna de las opciones</SelectItem>
                            <SelectItem TValue="string" Value="@("Maestro")">Docente</SelectItem>
                            <SelectItem TValue="string" Value="@("Investigador")">Investigador</SelectItem>
                            <SelectItem TValue="string" Value="@("Director")">Director</SelectItem>
                            <SelectItem TValue="string" Value="@("Jefe_de_Pregrado")">Jefe de pregrado</SelectItem>
                            <SelectItem TValue="string" Value="@("Administrador")">Administrador</SelectItem>
                        </Select>
                    </Field>
                </Validation>
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="rolAsociado">Rol asociado</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="rolAsociado" @bind-SelectedValue=currentUser.RolId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var r in roles)
                            {
                                <SelectItem TValue="Guid" Value="@r.Id">
                                    @r.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="facultadAsociada">Facultad asociada</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="facultadAsociada" @bind-SelectedValue=currentUser.FacultadId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var f in facultades)
                            {
                                <SelectItem TValue="Guid" Value="@f.Id">
                                    @f.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
            </Validations>
        </fieldset>
    </Form>

    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                   Clicked="submit">
            @buttonText
        </Button>
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="goBack">
            Cancelar
        </Button>
    </Div>

</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, false)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessageAndRedirectViewPage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, true)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>


@code {
    // La estructura de CreateUpdateUser es la misma que CreateUpdateActivity, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    [Parameter] 
    public Guid? userId { get; set; }

    private List<FacultadComboDTO> facultades = new();
    private List<RolComboDTO> roles = new();
    private List<CarreraComboDTO> carreras = new();

    private User currentUser = new();
    private string pageTitle = "";
    private string buttonText = "";

    private Validations validations;

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    private Modal modalToShowErrorMessageAndRedirectViewPage;

    private void ValidateGuidSelection(ValidatorEventArgs e)
    {
        if (e.Value is Guid guid && guid == Guid.Empty)
        {
            e.Status = ValidationStatus.Error;
        }
        else
        {
            e.Status = ValidationStatus.Success;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            facultades = await FacultadApiService.GetComboAsync();
            roles = await RoleApiService.GetComboAsync();
            carreras = await CarreraApiService.GetComboAsync();

            if (userId is not null && userId != Guid.Empty)
            {
                var responseToGetId = await UsuarioApiService.GetByIdAsync(userId.Value);

                if (!responseToGetId.Success)
                {
                    switch (responseToGetId.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();

                            break;

                        default:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                var dto = responseToGetId.Data;

                currentUser = new User
                {
                    Id = dto!.Id,
                    NombreUsuario = dto.NombreUsuario,
                    CorreoInstitucional = dto.CorreoInstitucional,
                    TipoUsuario = dto.TipoUsuario,
                    RolId = dto.RolId,
                    FacultadId = dto.FacultadId,
                    CarreraId = dto.CarreraId
                };

                pageTitle = "Editar directriz";
                buttonText = "Actualizar";
            }
            else
            {
                currentUser = new User();
                pageTitle = "Crear directriz";
                buttonText = "Crear";
            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessageAndRedirectViewPage.Show();
        } 
        finally
        {
            isLoading = false;
        }
    }

    private async Task submit()
    {
        if (await validations.ValidateAll())
        {
            await saveUser();
        }
    }

    private async Task saveUser()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var dto = new UsuarioCreateUpdateDto
            {
                NombreUsuario = currentUser.NombreUsuario,
                CorreoInstitucional = currentUser.CorreoInstitucional,
                TipoUsuario = currentUser.TipoUsuario,
                RolId = currentUser.RolId,
                FacultadId = currentUser.FacultadId,
                CarreraId = currentUser.CarreraId
            };

            if (userId is null || userId == Guid.Empty){

                var response = await UsuarioApiService.CreateAsync(dto);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }  
            else
            {
                var response = await UsuarioApiService.UpdateAsync(currentUser.Id, dto);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.NotFound:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }

            NavManager.NavigateTo("/home/vistaUsuarios");

        } finally
        {
            isLoading = false;
        }
        
    }

    private void goBack(){
        NavManager.NavigateTo("/home/vistaUsuarios");
    }

    private Task HideModal(Modal modal, bool value)
    {
        if (value)
        {
            NavManager.NavigateTo("/home/vistaUsuarios");
            return modal.Hide();
        }
        else
        {
            return modal.Hide();
        }
    }
}
