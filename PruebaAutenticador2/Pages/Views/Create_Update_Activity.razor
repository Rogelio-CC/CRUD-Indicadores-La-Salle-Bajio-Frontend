<!-- Ruta de la interfaz. -->
@page "/home/vistaActividades/creacionActividad"
@page "/home/vistaActividades/creacionActividad/{activityId:guid}"
<!-- Se requiere que el usuario esté autenticado para acceder a esta página. -->
@attribute [Authorize]

<!-- Importación de librerías/servicios. -->
@inject NavigationManager NavManager
@inject ActividadApiService ActividadApiService
@inject UsuarioApiService UsuarioApiService
@inject PeriodoEscolarApiService PeriodoEscolarApiService
@inject CarreraApiService CarreraApiService
@inject EstrategiaApiService EstrategiaApiService
@inject ComentarioApiService ComentarioApiService
@inject EmailService EmailService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@using System.ComponentModel.DataAnnotations
@using PruebaAutenticador2.Shared.DTOS.ListaCombos
@using PruebaAutenticador2.Shared.DTOS.Actividad
@using System.Net
@inject AuthStateService AuthState

<!-- Importaciones de estilos CSS. -->
<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/AllForms.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<!-- Título principal de la pestaña. -->
<PageTitle>@pageTitle</PageTitle>

<!-- Se llama al elemento .razor del navbar en mayoría de las pantallas. -->
<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<!-- Título principal de la pantalla. -->
<h1>Actividad</h1>

<!-- Línea de seperación entre el título de la página y el contenido. -->
<Divider Class="separate-line-register" />

<!-- Contenedor del formulario de registro/actualización. -->
<Div Class="container-register">
    <Form>
        <fieldset class="form-grid">
            <!-- Se agrega Validations para la verificación correcta de los inputs. -->
            <Validations @ref="validations" Mode="ValidationMode.Auto" Model="currentActivity">

                <!-- Dentro de Validations, se pueden poner diversos Validation individuales para agregar una regla que ayude a cumplir que el input este completado, por ejemplo. -->
                <Validation Validator="@ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="descripcion">Descripción</FieldLabel>
                        <!--Input de cadenas-->
                        <TextEdit Class="form-control" ElementId="descripcion" @bind-Text=currentActivity.DescripcionActividad />
                    </Field>
                </Validation>

                <Validation Validator="ValidationRule.IsSelected">
                    <Field Class="form-field">
                        <FieldLabel For="actividadCumplida">¿Se cumplió la actividad?</FieldLabel>
                        <!--Combobox-->
                        <Select Class="form-select" TValue="bool" ElementId="actividadCumplida" SelectedValue="@currentActivity.ActividadCumplida" SelectedValueChanged="@OnSelectedValueChanged">
                            <SelectItem TValue="bool" Value=true>Sí</SelectItem>
                            <SelectItem TValue="bool" Value=false>No</SelectItem>
                        </Select>
                    </Field>
                </Validation>

                <Field Class="form-field">
                    <FieldLabel For="fechaCumplimientoActividad">Fecha de cumplimiento</FieldLabel>
                    <!--Input para poner fechas-->
                    <DateEdit TValue="DateTimeOffset?" ElementId="fechaCumplimientoActividad" @bind-Date=currentActivity.FechaCumplimiento Disabled=complianceDateDisableInput />
                </Field>

                <Field Class="form-field">
                    <FieldLabel For="cantidadLograda">Cantidad lograda</FieldLabel>
                    <!--Input de números-->
                    <NumericEdit TValue="decimal" Class="form-control" ElementId="cantidadLograda" @bind-Value=currentActivity.CantidadLograda />
                </Field>

                <!-- Se puede poner Validation personalizado, como en este caso para evaluar que este llenado correctamente el valor de un ID. -->
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="creadorAsociado">Creador asociado</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="creadorAsociado" @bind-SelectedValue=currentActivity.CreadorId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            <!-- Se usa un foreach para visualizar la lista de elementos existentes (para esta ocasión, muestra una lista de usuarios existentes). -->
                            @foreach (var u in usuarios)
                            {
                                <SelectItem TValue="Guid" Value="@u.Id">
                                    @u.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>

                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="estrategiaAsociada">Estrategia asociada</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="estrategiaAsociada" @bind-SelectedValue=currentActivity.EstrategiaId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var es in estrategias)
                            {
                                <SelectItem TValue="Guid" Value="@es.Id">
                                    @es.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>

                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="periodoEscolarAsociado">Período escolar asociado</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="periodoEscolarAsociado" @bind-SelectedValue=currentActivity.PeriodoId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var p in periodos)
                            {
                                <SelectItem TValue="Guid" Value="@p.Id">
                                    @p.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>

                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="carreraAsociada">Carrera asociada</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="carreraAsociada" @bind-SelectedValue=currentActivity.CarreraId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var c in carreras)
                            {
                                <SelectItem TValue="Guid" Value="@c.Id">
                                    @c.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>

                 <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="comentarioAsociado">Comentario asociado (una vez cambiado el valor "Ninguno" ya pedirá un comentario forzosamente. Si no se necesita uno, dejar el valor predeterminado)</FieldLabel>
                        <Select Class="form-select" TValue="Guid?" ElementId="comentarioAsociado" @bind-SelectedValue=currentActivity.ComentarioId>
                        <SelectItem TValue="Guid?" Value=Guid.Empty">Ninguno</SelectItem>
                            @foreach (var co in comentarios)
                            {
                                <SelectItem TValue="Guid" Value="@co.Id">
                                    @co.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
            </Validations>
            <!-- Elementos como Actividad e Indicador contienen esta parte de agregar una fecha y hora de recordatorio de manera opcional. -->
            <Field Class="form-field">
                <FieldLabel For="fechaRecordatorio">Fecha de actulización</FieldLabel>
                <DateEdit TValue="DateTime?" Disabled="@(!remiderActivateActivity)" ElementId="fechaRecordatorio" @bind-Date=FechaRecordatorio />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="horaRecordatorio">Hora de actulización</FieldLabel>
                <TimeEdit TValue="TimeSpan?" Disabled="@(!remiderActivateActivity)" ElementId="horaRecordatorio" @bind-Time=HoraRecordatorio />
            </Field>
        </fieldset>
        <Div Style="display: flex; align-items: center; justify-content: center; font-family:IndivisaFont;">
            <!-- CheckBox que ayuda a que se habiliten o no los inputs referentes al recordatorio. Si el rol es Maestro o Investigador, entonces se deshabilita esta opción. -->
            <Check TValue="bool" @bind-Checked="remiderActivateActivity" Disabled="@(AuthState.Role == "Maestro" || AuthState.Role == "Investigador")">Activar recordatorio de modificación de la actividad</Check>
        </Div>
    </Form>

    <!--Contenedor de botónes-->
    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                           background-color: #002855;
                           color: #ffffff;
                           width:50%;
                           box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                           text-transform: uppercase;"
                Clicked="submit">
            @buttonText
        </Button>
        <Button Style="font-family:IndivisaFont;
                           background-color: #002855;
                           color: #ffffff;
                           width:50%;
                           box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                           text-transform: uppercase;"
                Clicked="goBack">
            Cancelar
        </Button>
    </Div>
</Div>

<!-- Se llama al elemento .razor del footer en mayoría de las pantallas. -->
<PruebaAutenticador2.Pages.ReusableComponents.Footer />

<!-- Si los elementos todavía no se cargan, muestra la pantalla "cargando". -->
@if (isLoading)
{
    <Div Style="position: fixed; 
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<!-- Modal para mostrar el mensaje de error. -->
<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, false)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<!-- Modal para mostrar el mensaje de error y redireccionar a la pantalla de vista de elementos (en este caso, vista de actividades). -->
<Modal @ref="@modalToShowErrorMessageAndRedirectViewPage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, true)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>



@code {
    // El parámetro activityId se obtiene de la URL, si es que se proporciona. Si no se proporciona, se asume que se está creando una nueva actividad.
    [Parameter]
    public Guid? activityId { get; set; }

    // Listas para llenar los combos de selección, como el de usuarios, estrategias, periodos escolares y carreras.
    private List<UsuarioComboDTO> usuarios = new();
    private List<EstrategiaComboDTO> estrategias = new();
    private List<PeriodoEscolarComboDTO> periodos = new();
    private List<CarreraComboDTO> carreras = new();
    private List<ComentarioComboDTO> comentarios = new();

    // Variable que sirve para válidar que el checkbox este activado
    private bool remiderActivateActivity { get; set; } = false;

    // Variable que representa la actividad que se va a crear o actualizar, dependiendo de si se proporciona un activityId o no.
    private Activity currentActivity = new();

    // Variables para el título de la página y el texto del botón, que cambian dependiendo de si se está creando o editando una actividad.
    private string pageTitle = "";
    private string buttonText = "";

    // Variables para el envío de correo, como el destinatario, el email autenticado, la fecha y hora del recordatorio, el asunto y el mensaje.
    private string destinatario = "";
    private string authenticatedEmail = "";
    private DateTime? FechaRecordatorio { get; set; } = null;
    private TimeSpan? HoraRecordatorio { get; set; } = null;
    private string asunto = "";
    private string mensaje = "";

    // Variable para habilitar o deshabilitar el input de fecha de cumplimiento, dependiendo de si la actividad se ha cumplido o no.
    bool complianceDateDisableInput = true;

    // Variable para manejar las validaciones del formulario.
    private Validations validations;

    // Variable para mostrar la pantalla de carga mientras se están obteniendo los datos o se está guardando la actividad.
    private bool isLoading = false;

    // variable para almacenar el mensaje de error que se mostrará en caso de que ocurra algún error al obtener los datos o guardar la actividad.
    private string? errorMessage;

    // Variables para manejar los modales que muestran los mensajes de error, dependiendo de si el error requiere o no redireccionar a la pantalla de vista de actividades.
    private Modal modalToShowErrorMessage;
    private Modal modalToShowErrorMessageAndRedirectViewPage;

    // Método de validación personalizado para verificar que el valor seleccionado en los combos de selección no sea Guid.Empty, lo que indicaría que no se ha seleccionado una opción válida.
    private void ValidateGuidSelection(ValidatorEventArgs e)
    {
        if (e.Value is Guid guid && guid == Guid.Empty)
        {
            e.Status = ValidationStatus.Error;
        }
        else
        {
            e.Status = ValidationStatus.Success;
        }
    }

    // Método que se ejecuta cuando se carga la página o cuando se proporciona un activityId en la URL. 
    // En este método se obtienen los datos necesarios para llenar los combos de selección y, si se proporciona un activityId, 
    // se llenan los campos del formulario con los datos de la actividad correspondiente para su edición. 
    // Si ocurre algún error durante este proceso, se muestra un mensaje de error en un modal.
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged(); // Se llama a StateHasChanged para asegurarse de que la interfaz de usuario se actualice y muestre el estado de carga antes de realizar las operaciones asincrónicas.

            // Se obtienen los datos para llenar los combos de selección, como la lista de usuarios, estrategias, periodos escolares y carreras.
            usuarios = await UsuarioApiService.GetComboAsync();
            estrategias = await EstrategiaApiService.GetComboAsync();
            periodos = await PeriodoEscolarApiService.GetComboAsync();
            carreras = await CarreraApiService.GetComboAsync();
            comentarios = await ComentarioApiService.GetComboAsync();

            if (activityId is not null && activityId != Guid.Empty)
            {
                // Si se proporciona un activityId, se llama al método GetByIdAsync del servicio de actividad para obtener los datos de la actividad correspondiente a ese ID. 
                // Si la respuesta no es exitosa, se muestra un mensaje de error en un modal. Si la respuesta es exitosa, se obtiene el DTO de la actividad y 
                // se asigna a currentActivity para llenar los campos del formulario con los datos correspondientes.
                var responseToGetId = await ActividadApiService.GetByIdAsync(activityId.Value);

                if (!responseToGetId.Success)
                {
                    switch (responseToGetId.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        default:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                var dto = responseToGetId.Data;

                currentActivity = new Activity
                {
                    Id = dto!.Id,
                    DescripcionActividad = dto.DescripcionActividad,
                    CantidadLograda = dto.CantidadLograda,
                    FechaCumplimiento = dto.FechaCumplimiento,
                    ActividadCumplida = dto.ActividadCumplida,
                    EstrategiaId = dto.EstrategiaId,
                    CreadorId = dto.CreadorId,
                    PeriodoId = dto.PeriodoId,
                    CarreraId = dto.CarreraId,
                    ComentarioId = dto.ComentarioId,
                };

                pageTitle = "Editar Actividad";
                buttonText = "Actualizar";
            }
            else
            {
                // Si no se proporciona un activityId, se asume que se está creando una nueva actividad, por lo que se inicializa currentActivity con una nueva instancia de Activity.
                currentActivity = new Activity();
                pageTitle = "Crear Actividad";
                buttonText = "Crear";
            }
        

        } 
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessageAndRedirectViewPage.Show();
        }
        finally
        {
            isLoading = false; // Se establece isLoading en false para ocultar la pantalla de carga una vez que se han obtenido los datos o se ha producido un error.
        }
    }

    // Método que se ejecuta cuando se hace clic en el botón de crear o actualizar. 
    // En este método se validan los campos del formulario y, si la validación es exitosa, se llama al método saveActivity para guardar la actividad. 
    // Si ocurre algún error durante este proceso, se muestra un mensaje de error en un modal.
    private async Task submit()
    {
        if (await validations.ValidateAll())
        {
            await saveActivity();
        }
    }

    // Método que se encarga de guardar la actividad, ya sea creando una nueva o actualizando una existente, dependiendo de si se proporciona un activityId o no.
    private async Task saveActivity()
    {
        try
        {
            isLoading = true;
            StateHasChanged();


            var dto = new ActividadCreateUpdateDto
            {
                DescripcionActividad = currentActivity.DescripcionActividad,
                CantidadLograda = currentActivity.CantidadLograda,
                FechaCumplimiento = currentActivity.FechaCumplimiento,
                ActividadCumplida = currentActivity.ActividadCumplida,
                EstrategiaId = currentActivity.EstrategiaId,
                CreadorId = currentActivity.CreadorId,
                PeriodoId = currentActivity.PeriodoId,
                CarreraId = currentActivity.CarreraId,
                ComentarioId = currentActivity.ComentarioId,
            };

            if (activityId is null || activityId == Guid.Empty)
            {
                var response = await ActividadApiService.CreateAsync(dto);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
                // Si la creación o actualización es exitosa, se verifica si se han proporcionado una fecha y hora para el recordatorio.
                // Si ambos valores están presentes, se llama al método EnviarCorreo para enviar un correo electrónico con los detalles del recordatorio.
                if (HoraRecordatorio != null && FechaRecordatorio != null)
                {
                    try
                    {
                        await EnviarCorreo();
                    }
                    catch (Exception ex)
                    {
                        // Loguea el error pero no rompas la app
                        Console.WriteLine($"Error enviando correo: {ex.Message}");
                        errorMessage = "La actividad se guardó, pero no pudimos enviar el correo de recordatorio.";
                        await modalToShowErrorMessage.Show();
                    }
                }
            }
            else
            {
                var response = await ActividadApiService.UpdateAsync(currentActivity.Id, dto);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.NotFound:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        case HttpStatusCode.Forbidden:
                            errorMessage = "No puedes modificar ni eliminar actividades que no son de tu propiedad.";
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                if (HoraRecordatorio != null && FechaRecordatorio != null)
                {
                    try
                    {
                        await EnviarCorreo();
                    }
                    catch (Exception ex)
                    {
                        // Loguea el error pero no rompas la app
                        Console.WriteLine($"Error enviando correo: {ex.Message}");
                        errorMessage = "La actividad se guardó, pero no pudimos enviar el correo de recordatorio.";
                        await modalToShowErrorMessage.Show();
                    }
                }
            }

            NavManager.NavigateTo("/home/vistaActividades");
        }
        finally
        {
            isLoading = false;
        }
    }

    // Método que se encarga de enviar un correo electrónico con los detalles del recordatorio para modificar la actividad.
    private async Task EnviarCorreo()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userClaims = authState.User;

        if (userClaims.Identity!.IsAuthenticated)
        {
            authenticatedEmail = userClaims.Claims.FirstOrDefault(c => c.Type == "preferred_username")?.Value ?? "";
        }

        destinatario = authenticatedEmail;

        asunto = $"Correo enviado para modificar la actividad '{currentActivity.DescripcionActividad}'";

        // Variable que contiene la estrctura html del correo enviado con información
        string bodyHTML = @"
                            <html>
                            <body style='margin:0; padding:0;'>
                                <div style='width:100%; font-family: Arial, sans-serif; background-color:#f9fafb; padding:20px;'>
                                    <div style='max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.1); padding:30px;'>
                            
                                        <div style='border-bottom:2px solid #002855; padding-bottom:10px; text-align: center; color:#002855; margin:0; font-size: 26px; font-weight: bold;'>
                                            📩 Recordatorio
                                        </div>
                            
                                        <div style='padding-top:20px; color:#002855;'>
                                            <p style='font-size:16px; text-align: left; line-height: 1.5;'>
                                                Este correo fue enviado automáticamente desde la aplicación de <strong>Gestión de Indicadores</strong> de la Universidad La Salle Bajío.
                                            </p>
                            
                                            <div style='background-color:#f3f4f6; padding:15px; border-radius:8px; margin-top:15px; margin-bottom: 15px;'>
                                                <p style='margin:0; font-size:16px; text-align:left; color:#002855;'>
                                                    <strong>📅 Fecha programada:</strong> {{FECHA}}<br />
                                                    <strong>⏰ Hora programada:</strong> {{HORA}}
                                                </p>
                                            </div>
                            
                                            <p style='font-size:14px; color:#6b7280; text-align: left; margin-bottom: 15px;'>
                                                Si no esperabas este correo, puedes ignorarlo con seguridad.
                                            </p>
                                        </div>
                            
                                        <div style='padding-top:20px; border-top:2px solid #e5e7eb; margin-top:15px;'>
                                            <p style='font-size:12px; color:#9ca3af; text-align: left;'>
                                                © {{ANIO}} Gestión de Indicadores | Universidad La Salle Bajío
                                            </p>
                                        </div>
                            
                                    </div>
                                </div>
                            </body>
                            </html>";

        bodyHTML = bodyHTML.Replace("{{FECHA}}", FechaRecordatorio!.Value.ToString("dd/MM/yyyy"))
                   .Replace("{{HORA}}", HoraRecordatorio.ToString())
                   .Replace("{{ANIO}}", DateTime.Now.Year.ToString());

        mensaje = bodyHTML;

        await EmailService.SendEmailAsync(destinatario, asunto, mensaje);
    }

    // Método que se ejecuta cuando se cambia el valor seleccionado en el combo de selección que indica si la actividad se ha cumplido o no.
    private void OnSelectedValueChanged(bool value)
    {
        currentActivity.ActividadCumplida = value;

        if (value)
        {
            complianceDateDisableInput = false;
        }
        else
        {
            complianceDateDisableInput = true;
        }
    }

    // Método que se ejecuta cuando se hace clic en el botón de cancelar, redireccionando a la pantalla de vista de actividades.
    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaActividades");
    }

    // Método que se encarga de ocultar el modal que muestra el mensaje de error. 
    // Si el valor del parámetro "value" es true, se redirecciona a la pantalla de vista de actividades después de ocultar el modal. 
    // Si el valor es false, simplemente se oculta el modal sin redireccionar.
    private Task HideModal(Modal modal, bool value)
    {
        if (value)
        {
            NavManager.NavigateTo("/home/vistaActividades");
            return modal.Hide();
        }
        else
        {
            return modal.Hide();
        }
    }
}
