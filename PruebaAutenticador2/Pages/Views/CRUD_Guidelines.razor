<!-- La estructura .razor de CRUDGuidelines es la misma que CRUDActivities,  por lo que se reutiliza varias partes de código de esa vista para esta.-->
@page "/home/vistaDirectrices"
@attribute [Authorize]

@inject NavigationManager NavManager
@using PruebaAutenticador2.Services
@using PruebaAutenticador2.Shared.DTOS.Directriz
@inject DirectrizApiService DirectrizApiService
@inject AuthStateService AuthState

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/Tables.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<PageTitle>Lista de directrices</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<Div Class="header-section">
    <h1 class="title-general">Lista de directrices</h1>
    <Div Class="header-buttons">
        <Button Class="add-button" Clicked="@addGuideline">
            Agregar directriz
        </Button>
        <Button Class="add-button" Clicked="@goBack">
            Regresar al inicio
        </Button>
    </Div>
</Div>

<Divider Class="separate-line" />

<Div Class="search-container">
    <Span Class="search-icon">
        <i class="fas fa-search"></i>
    </Span>
    <TextEdit Placeholder="Busca por descripción" Class="search-bar" Text="@searchText" TextChanged="@OnSearchChanged" />
</Div>

<Div Class="table-container">
    <Table Bordered ResponsiveMode="TableResponsiveMode.Mobile" align="left" Class="all-table">
        <TableHeader>
            <TableRow>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Descripción
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Creador asociado
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Período escolar asociado
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Acciones
                </TableHeaderCell>
            </TableRow>
        </TableHeader>
        <TableBody>
            @foreach(var guideline in filteredGuidelines)
            {
                <TableRow>
                    <TableRowCell MobileModeCaption="Descripción">@guideline.Descripcion</TableRowCell>
                    <TableRowCell MobileModeCaption="Creador asociado">@guideline.Creador</TableRowCell>
                    <TableRowCell MobileModeCaption="Período escolar asociado">@guideline.Periodo</TableRowCell>
                    <TableRowCell>
                        <Div Class="buttons-container">
                            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Clicked="() => viewGuideline(guideline.Id)">
                                Detalles
                            </Button>
                            @if (CanEditOrDelete(guideline.CreadorId))
                            {
                                <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-left: 15px;" Clicked="() => editGuideline(guideline.Id)">
                                    Editar
                                </Button>
                                <Button Style="font-family:IndivisaFont; background-color: #CF152D; color: #ffffff; margin-left: 15px;" Clicked="() => confirmDelete(guideline.Id)">
                                    Eliminar
                                </Button>
                            }
                        </Div>
                    </TableRowCell>
                </TableRow>
            }
        </TableBody>
    </Table>
</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}


<Modal @ref="modalRef">
    <ModalContent Centered>
        <ModalHeader Style="background-color: #002855;">
            <ModalTitle Style="font-family:IndivisaFontBold; color: #ffffff;">Eliminación de una directriz</ModalTitle>
            <CloseButton Style="background-color: #ffffff; opacity: 1;" />
        </ModalHeader>
        <ModalBody>
            <Field>
                <FieldLabel Style="font-family:IndivisaFont;">¿Quieres eliminar esta directriz?</FieldLabel>
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Clicked="() => HideModal(modalRef)">No</Button>
            <Button Style="font-family:IndivisaFont; background-color: #CF152D; color: #ffffff;" Clicked="@deleteGuideline">Si</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>


@code {
    // La estructura de CRUDGuidelines es la misma que CRUDActivities, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    private List<DirectrizDto> guidelineList = new();

    private string searchText = string.Empty;
    private List<DirectrizDto> filteredGuidelines = new();

    private bool isLoading = false;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadGuidelines();
    }

    private async Task LoadGuidelines()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await DirectrizApiService.GetAllAsync();

            guidelineList = response.Data!.OrderBy(r => r.Descripcion).ToList();

            filteredGuidelines = guidelineList;

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchChanged(string value)
    {
        searchText = value;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredGuidelines = guidelineList;
        }
        else
        {
            filteredGuidelines = guidelineList
                .Where(a =>
                    a.Descripcion.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private bool CanEditOrDelete(Guid creadorId)
    {
        if (AuthState.Role == "Administrador") return true;

        if (AuthState.IdUser == null) return false;

        return creadorId.ToString() == AuthState.IdUser;
    }


    private void addGuideline()
    {
        NavManager.NavigateTo("/home/vistaDirectrices/creacionDirectriz");
    }

    private Guid guidelineToDelete;

    private void viewGuideline(Guid id)
    {
        NavManager.NavigateTo($"/home/vistaDirectrices/detalleDirectriz/{id}");
    }

    private void editGuideline(Guid id)
    {
        NavManager.NavigateTo($"/home/vistaDirectrices/creacionDirectriz/{id}");
    }

    private Task confirmDelete(Guid id)
    {
        guidelineToDelete = id;
        return modalRef.Show();
    }

    private async Task deleteGuideline()
    {
        var response = await DirectrizApiService.DeleteAsync(guidelineToDelete);

        if (!response.Success)
        {
            errorMessage = response.ErrorMessage ?? "No se pudo eliminar la directriz";
            modalToShowErrorMessage?.Show();
            return;
        }

        await LoadGuidelines();
        await modalRef.Hide();
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home");
    }

    private Modal modalRef;
    private Modal modalToShowErrorMessage;

    private Task HideModal(Modal modal)
    {
        return modal.Hide();
    }

}

