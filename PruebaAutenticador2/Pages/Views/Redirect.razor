<!-- Ruta de la interfaz. -->
@page "/redirect"
<!-- Se requiere que el usuario esté autenticado para acceder a esta página. -->
@attribute [Authorize]

<!-- Importación de librerías/servicios. -->
@using PruebaAutenticador2.Services
@inject AuthenticationStateProvider AuthProvider
@inject AuthApiService AuthApi
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject TokenStorageService tokenStorageService;

<!-- Se reutiliza esta misma pantalla de carga para indicar que esta evaluando a que pantalla mandar al usuario, dependiendo si esta autenticado o no. -->
<Div Style="position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;">
    <Div Class="spinner-border text-white"/>
</Div>

@code {
    // Al iniciar la página, se verifica el estado de autenticación del usuario.
    // Si no está autenticado, se redirige a la página de inicio de sesión. 
    // Si está autenticado, se obtiene su correo electrónico y se intenta iniciar sesión en la API para obtener un token JWT.
    // Nota: el atributo replace: true en Nav.NavigateTo se utiliza para reemplazar la URL actual (redirect) en el historial del navegador, 
    // evitando que el usuario pueda volver a esta página de redirección utilizando el botón "Atrás" del navegador. Sin embargo, 
    // por la existencia de múltiples métodos asíncronos en esta página, es posible que tarde en implementarse por completo por el renderizado de la misma,
    // logrando por completo el remplazo de la URL actual después de unos segundos o cuando el usuario intenta volver a /redirect por segunda vez y ya se bloquee el acceso a esta página.
    protected override async Task OnInitializedAsync()
    {
        // Checa si ya se tiene un token JWT en memoria o en el almacenamiento local. Si es así, se redirige a la página principal de la aplicación.
        if (!string.IsNullOrEmpty(AuthState.JwtToken))
        {
            // Reemplaza la URL actual por /home (evita volver a /redirect con "Atrás")
            Nav.NavigateTo("/home", replace: true);
            return;
        }
        var existingToken = await tokenStorageService.GetTokenAsync();
        if (!string.IsNullOrEmpty(existingToken))
        {
            // Reemplaza la URL actual por /home (evita volver a /redirect con "Atrás")
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        // Si no se tiene el token en memoria o en almacenamiento local, se obtiene el estado de autenticación del usuario utilizando AuthenticationStateProvider para iniciar sesión en la API y obtener el token JWT.
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        // Se intenta obtener el correo electrónico del usuario desde las reclamaciones de AuthenticationStateProvider. Primero se busca "preferred_username" y si no se encuentra, se busca "email".
        var email =  user.FindFirst("preferred_username")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        // Si no se encuentra el correo electrónico, se redirige a una página de error indicando que el usuario no fue encontrado.
        if (string.IsNullOrEmpty(email))
        {
            Nav.NavigateTo("/usuario-no-encontrado", replace: true);
            return;
        }

        // Intentar iniciar sesión en la API para obtener el token JWT.
        var loginResponse = await AuthApi.LoginAsync(email);

        // Si la respuesta de inicio de sesión es nula, se redirige a una página de error indicando que el usuario no fue encontrado.
        if (loginResponse == null)
        {
            Nav.NavigateTo("/usuario-no-encontrado", replace: true);
            return;
        }

        // Guardar en memoria el token JWT.
        AuthState.SetToken(loginResponse.Token);
        await tokenStorageService.SetTokenAsync(loginResponse.Token);

        // Extraer rol del token y Id del usuario.
        var rol = JwtHelper.GetRole(loginResponse.Token);
        var idUser = JwtHelper.GetIdUser(loginResponse.Token);

        // Verificar que el rol sea uno de los roles permitidos. Si no es así, se redirige a una página de error indicando que el rol no fue identificado.
        if (string.IsNullOrEmpty(rol) || 
            rol != "Administrador" && 
            rol != "Jefe_de_Pregrado" && 
            rol != "Director" && 
            rol != "Investigador" && 
            rol != "Maestro")
        {
            Nav.NavigateTo("/rol-no-identificado", replace: true);
            return;
        }

        // Verificar que se haya obtenido un Id de usuario válido. Si no es así, se redirige a una página de error indicando que el usuario no fue encontrado.
        if (string.IsNullOrEmpty(idUser))
        {
            Nav.NavigateTo("/usuario-no-encontrado", replace: true);
            return;
        }

        // Guardar rol y Id del usuario en memoria.
        AuthState.SetRole(rol);
        AuthState.SetIdUser(idUser);

        // Redirigir a la página principal de la aplicación. 
        // Dependiendo de la implementación de la aplicación, se podría redirigir a diferentes páginas dependiendo del rol del usuario.
        Nav.NavigateTo("/home", replace: true);
    }

}
