<!--Ruta de la interfaz-->
@page "/home/verCalendario/"
<!-- Se requiere que el usuario esté autenticado para acceder a esta página -->
@attribute [Authorize]

<!--Importación de librerías/servicios-->
@inject NavigationManager NavManager
@using System.Globalization
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@inject AuthStateService AuthState
@inject EventosCalendarioService EventosCalendarioService

<!--Importaciones de estilos CSS-->
<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/Footer.css" />
<link rel="stylesheet" href="css/Calendar.css" />

<!--Título principal de la pestaña-->
<PageTitle>Vista de las gráficas</PageTitle>

<!--Se llama al elemento .razor del navbar en mayoría de las pantallas-->
<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role"/>

<!--Título principal de la pantalla-->
<h1>Calendario</h1>

<!--Línea de seperación entre el título de la página y el contenido-->
<Divider Class="separate-line-calendar" />

<!--Contenedor del formulario para buscar algun evento del calendario-->
<Div Class = "container-search">
    <Form>
        <fieldset class="form-search">
            <Field Class="form-field-search">
                <FieldLabel For="Evento">Evento</FieldLabel>
                <Select Class="form-select-search"
                        TValue="string"
                        SelectedValue="@filterTitle"
                        SelectedValueChanged="(value) => { filterTitle = value; ApplyFilters(); }">
                    <SelectItem TValue="string" Value="string.Empty">Selecciona alguna de las opciones</SelectItem>
                    @foreach(var academicEvent in AcademicEvents)
                    {
                        <SelectItem TValue="string" Value="@academicEvent.Titulo">@academicEvent.Titulo</SelectItem>
                    }
                </Select>
            </Field>
            <Field Class="form-field">
                <FieldLabel For="Fecha de inicio">Fecha de inicio</FieldLabel>
                <DateEdit TValue="DateTime?"
                          Date="@filterStart"
                          DateChanged="(value) => { filterStart = value; ApplyFilters(); }" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="Fecha de finalizacion">Fecha de finalización</FieldLabel>
                <DateEdit TValue="DateTime?"
                          Date="@filterEnd"
                          DateChanged="(value) => { filterEnd = value; ApplyFilters(); }" />
            </Field>
        </fieldset>
    </Form>
</Div>

<!--Contenedor principal del calendario-->
<Div class="academic-calendar-container">
    <!-- Encabezado con navegación -->
    <Div Class="calendar-navigation">
        <Button @onclick="() => ChangeMonth(-1)">
            <Icon Name="IconName.ChevronLeft" Style="color:white"/>
        </Button>

        <Heading Size="HeadingSize.Is4" Class="calendar-title">
            @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(currentMonth) @currentYear
        </Heading>

        <Button @onclick="() => ChangeMonth(1)">
            <Icon Name="IconName.ChevronRight" Style="color:white" />
        </Button>
    </Div>

    <!-- Días de la semana (fila horizontal) -->
    <Div Class="weekdays-header">
        @foreach (var day in Enum.GetValues(typeof(DayOfWeek)))
        {
            <Div class="weekday">
                @CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName((DayOfWeek)day)
            </Div>
        }
    </Div>

    <!-- Cuadrícula de días -->
    <Div Class="calendar-grid">
        @{
            // Obtener las semanas del mes actual
            var weeks = GetWeeksInMonth(currentYear, currentMonth);

            // Mostrar solo las semanas que contengan días del mes actual
            var weeksToShow = weeks.Where(week => week.Any(day => day != DateTime.MinValue));
        }
        <!--Visualización de los días y las semanas correspondientes al mes y al evento, mostrando el color asociado al evento-->
        @foreach (var week in weeksToShow)
        {
            <div class="calendar-row">
                @foreach (var day in week)
                {
                    <div class="calendar-day"
                         style="background-color: @GetDayBackgroundColor(day)"
                         >
                        @if (day != DateTime.MinValue)
                        {
                            <div class="day-number">@day.Day</div>
                            <!--Visualización de los eventos y, cuando se presiona alguno de estos, muestra el modal para ver información de ese evento-->
                            @foreach (var eventItem in GetAcademicEvents(day))
                            {
                                <Div class="calendar-event" @onclick="() => ShowModal(eventItem)">
                                    @eventItem.Titulo
                                </Div>
                            }
                        }
                    </div>
                }
            </div>
        }
    </Div>
</Div>

<!--Modal para mostrar información de algun evento-->
<Modal @ref="@modalRef" Class="event-modal">
    <ModalContent Centered="true">
        <ModalBody>
            <h3 style="text-align:center;">@selectedEvent.Titulo</h3>
            <Div Class="event-dates">
                <h5>Tipo de evento: @selectedEvent.TipoEvento</h5>
                <h5>Día de inicio: @selectedEvent.FechaInicio.ToShortDateString()</h5> 
                <h5>Día de finalización: @selectedEvent.FechaFin.ToShortDateString()</h5>
            </Div>
                <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Block="true" Clicked="() => HideModal(modalRef)">
                    Ok
                </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<!--Modal para mostrar mensaje de error-->
<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<!--Se llama al elemento .razor del footer en mayoría de las pantallas-->
<PruebaAutenticador2.Pages.ReusableComponents.Footer/>

<!-- Si los elementos todavía no se cargan, muestra la pantalla "cargando" -->
@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

@code {

    // Variables para controlar el mes y año actual del calendario, 
    // el evento seleccionado, los filtros aplicados, 
    // la lista de eventos académicos, los eventos filtrados, el estado de carga y el mensaje de error.
    private int currentYear = DateTime.Now.Year;
    private int currentMonth = DateTime.Now.Month;
    private CalendarEvent selectedEvent = new();
    private string filterTitle = string.Empty;
    private DateTime? filterStart;
    private DateTime? filterEnd;
    private List<CalendarEvent> AcademicEvents = new();
    private List<CalendarEvent> filteredEvents = new();
    private bool isLoading = false;
    private string? errorMessage;

    // Referencias a los modales para mostrar información del evento y mensajes de error.
    private Modal modalRef;
    private Modal modalToShowErrorMessage;

    // Al iniciar la página, se cargan los eventos académicos desde el servicio y se aplican los filtros correspondientes. 
    // Si ocurre un error al cargar los eventos, se muestra un mensaje de error en un modal.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await EventosCalendarioService.GetAllAsync();

            AcademicEvents = response.Data!.ToList();
            
            filteredEvents = AcademicEvents;

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }
    }

    // Método para aplicar los filtros de búsqueda a la lista de eventos académicos.
    private void ApplyFilters()
    {
        filteredEvents = AcademicEvents.Where(ev =>
            (string.IsNullOrWhiteSpace(filterTitle) || ev.Titulo.Contains(filterTitle, StringComparison.OrdinalIgnoreCase)) &&
            (!filterStart.HasValue || ev.FechaInicio >= filterStart.Value) &&
            (!filterEnd.HasValue || ev.FechaFin <= filterEnd.Value)
        ).ToList();

        // Si NO hay filtros aplicados, regresar al mes actual
        bool noFilters = string.IsNullOrWhiteSpace(filterTitle) && !filterStart.HasValue && !filterEnd.HasValue;
        if (noFilters)
        {
            currentYear = DateTime.Now.Year;
            currentMonth = DateTime.Now.Month;
            return;
        }

        // Si hay eventos filtrados, mover al mes del primer evento encontrado
        if (filteredEvents.Count > 0)
        {
            // Ordenar los eventos filtrados por fecha de inicio y tomar el primero para establecer el mes y año actuales
            var firstEvent = filteredEvents.OrderBy(e => e.FechaInicio).First();

            // Establecer el mes y año actuales al mes del primer evento encontrado
            currentYear = firstEvent.FechaInicio.Year;
            currentMonth = firstEvent.FechaInicio.Month;
        }
        
    }

    // Método para cambiar el mes actual del calendario, sumando o restando meses según el valor de delta.
    private void ChangeMonth(int delta)
    {
        var newDate = new DateTime(currentYear, currentMonth, 1).AddMonths(delta);
        currentYear = newDate.Year;
        currentMonth = newDate.Month;
    }

    // Método para obtener las semanas de un mes específico, ajustando para que la semana comience en domingo y asegurando que se muestren al menos 6 filas de semanas.
    private List<DateTime[]> GetWeeksInMonth(int year, int month)
    {
        var firstDay = new DateTime(year, month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);

        var weeks = new List<DateTime[]>();
        var currentWeek = new DateTime[7];
        var currentDay = firstDay;

        // Ajuste para que la semana comience en Domingo
        while (currentDay.DayOfWeek != DayOfWeek.Sunday)
        {
            currentDay = currentDay.AddDays(-1);
        }

        // Llenar las semanas del mes, asegurando que se muestren al menos 6 filas de semanas
        while (currentDay <= lastDay || weeks.Count < 6)
        {
            for (int i = 0; i < 7; i++)
            {
                currentWeek[i] = (currentDay.Month == month) ? currentDay : DateTime.MinValue;
                currentDay = currentDay.AddDays(1);
            }
            weeks.Add(currentWeek);
            currentWeek = new DateTime[7];
        }

        return weeks;
    }

    // Método para obtener los eventos académicos que ocurren en un día específico, filtrando la lista de eventos según la fecha.
    private List<CalendarEvent> GetAcademicEvents(DateTime day)
    {
        return filteredEvents.Where(e => e.IsOnDate(day)).ToList();
    }

    // Método para determinar el color de fondo de un día en el calendario, basado en los eventos académicos que ocurren en ese día. 
    // Si hay eventos en algunos días compartidos, se toma el color del primer evento; si no hay eventos, se devuelve una cadena vacía (fondo blanco o transparente).
    private string GetDayBackgroundColor(DateTime day)
    {
        var events = GetAcademicEvents(day);
        if (events.Any())
        {
            // Aquí es donde se toma el color del primer evento
            return events.First().Color!;
        }
        return "";
    }

    // Método para mostrar el modal con la información de un evento específico cuando se hace clic en él.
    private Task ShowModal(CalendarEvent ev)
    {
        selectedEvent = ev;
        return modalRef.Show();
    }

    // Método para ocultar el modal de información del evento.
    private Task HideModal(Modal modal)
    {
        return modal.Hide();
    }
}