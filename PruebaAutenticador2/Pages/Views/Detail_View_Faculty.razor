<!-- La estructura .razor de DetailViewFaculty es la misma que DetailViewActivity,  por lo que se reutiliza varias partes de código de esa vista para esta. -->
@page "/home/vistaFacultades/detalleFacultad/{facultyId:guid}"
@attribute [Authorize]

@inject NavigationManager NavManager
@inject FacultadApiService FacultadApiService
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@inject AuthStateService AuthState
@using System.Net
@using PruebaAutenticador2.Shared.DTOS.ArchivoPoliticas
@inject ArchivoPoliticasApiService ArchivoPoliticasApiService
@inject IJSRuntime JS

<link rel="stylesheet" href="css/DetailV.css" />
<link rel="stylesheet" href="css/ViewPolicyFile.css" />
<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/Footer.css" />
<link rel="stylesheet" href="css/Fonts.css" />

<PageTitle>Detalles de la facultad</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Detalles de la facultad</h1>

<Divider Class="separate-line-detail" />

<Div Class="container-detail">
    <Form>
        <fieldset class="form-grid">
            <!-- Fila 1. -->
            <Field Class="form-field">
                <FieldLabel For="nombreDeLaFacultad">Nombre de la facultad</FieldLabel>
                <TextEdit Class="form-control" Text="@currentFaculty.Nombre" ReadOnly="true" ElementId="nombreDeLaFacultad" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="mision">Misión</FieldLabel>
                <MemoEdit Rows="5" Class="form-control" Text="@currentFaculty.Mision" ReadOnly="true" ElementId="mision" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="vision">Vision</FieldLabel>
                <MemoEdit Rows="5" Class="form-control" Text="@currentFaculty.Vision" ReadOnly="true" ElementId="vision" />
            </Field>

            <!-- Fila 2. -->
            <Field Class="form-field">
                <FieldLabel For="slogan">Slogan</FieldLabel>
                <TextEdit Class="form-control" Text="@(currentFaculty.Slogan ?? "")" ReadOnly="true" ElementId="slogan" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="fechaDeEmision">Fecha de emisión</FieldLabel>
                <TextEdit Class="form-control" Text="@currentFaculty.FechaEmision.ToString("dd/MM/yyyy")" ReadOnly="true" ElementId="fechaDeEmision" />
            </Field>

            <!-- Fila 3. -->
            <Field Class="container-archivo">
                <FieldLabel Class="label-archivo" For="archivo">Archivo</FieldLabel>
                @if (archivoPoliticas.Any())
                {
                    <ul class="list-archivo">
                        @foreach (var archivo in archivoPoliticas)
                        {
                            <li class="item-archivo">
                                <i class="bi bi-file-earmark-text-fill" style="color:#002855; margin-right:6px;"></i>
                                <Button Class="nombreArchivo" Clicked="() => DownloadFile(archivo)">
                                    @archivo.NombreArchivo
                                </Button>
                                <span class="tipo-archivo">(@archivo.Tipo)</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p style="color: #b22222; font-family:IndivisaFontBold;">No se ha subido el archivo.</p>
                }
            </Field>
        </fieldset>
    </Form>
    
    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                       background-color: #002855;
                       color: #ffffff;
                       width:96%;
                       box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                       text-transform: uppercase;"
                Clicked="goBack">
            Regresar
        </Button>
    </Div>
</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

@code {
    // La estructura de DetailViewFaculty es la misma que DetailViewActivity, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    [Parameter]
    public Guid? facultyId { get; set; }

    private Faculty currentFaculty = new();

    private List<ArchivoPoliticasDto> archivoPoliticas = new();

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (facultyId is not null && facultyId != Guid.Empty)
            {
                var responseToGetId = await FacultadApiService.GetByIdAsync(facultyId.Value);

                if (!responseToGetId.Success)
                {
                    switch (responseToGetId.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;
                    }

                    return;
                }

                var faculty = responseToGetId.Data;

                currentFaculty = new Faculty
                {
                    Id = faculty!.Id,
                    Nombre = faculty.Nombre,
                    Mision = faculty.Mision,
                    Vision = faculty.Vision,
                    Slogan = faculty.Slogan,
                    FechaEmision = faculty.FechaEmision,
                };

                var responseToGetFile = await ArchivoPoliticasApiService.GetByFacultyIdAsync(currentFaculty.Id);

                if (!responseToGetFile.Success)
                {
                    switch (responseToGetFile.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = responseToGetFile.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = responseToGetFile.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;
                    }

                    return;
                }

                archivoPoliticas = responseToGetFile.Data!;

            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadFile(ArchivoPoliticasDto archivoP)
    {
        var bytes = await ArchivoPoliticasApiService.DownloadAsync(
            currentFaculty.Id,
            archivoP.Id
        );

        // Se llama a la función JavaScript "downloadFile" que se encuentra en el archivo wwwroot/js/download.js,
        // pasando el nombre del archivo, el tipo y los bytes para que el navegador pueda descargarlo.
        await JS.InvokeVoidAsync(
            "downloadFile",
            archivoP.NombreArchivo,
            archivoP.Tipo,
            bytes
        );
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaFacultades");

    }

    private Task HideModal(Modal modal)
    {
        NavManager.NavigateTo("/home/vistaFacultades");
        return modal.Hide();
    }
}
