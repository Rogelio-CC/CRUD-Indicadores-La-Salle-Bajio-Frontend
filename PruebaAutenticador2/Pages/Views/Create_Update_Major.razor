@page "/home/vistaCarreras/creacionCarrera"
@page "/home/vistaCarreras/creacionCarrera/{majorId:guid}"
@attribute [Authorize]
@inject NavigationManager NavManager
@inject CarreraApiService CarreraApiService
@inject FacultadApiService FacultadApiService
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@using System.ComponentModel.DataAnnotations
@using PruebaAutenticador2.Shared.DTOS.Carrera
@using PruebaAutenticador2.Shared.DTOS.ListaCombos
@inject AuthStateService AuthState
@using System.Net

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/AllForms.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<PageTitle>@pageTitle</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Carrera</h1>

<Divider Class="separate-line-register" />

<Div Class="container-register">
    <Form>
        <fieldset class="form-grid">
            <Validations @ref="validations" Mode="ValidationMode.Auto" Model="currentMajor">
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="nombreCarrera">Nombre de la carrera</FieldLabel>
                        <TextEdit Class="form-control" ElementId="nombreCarrera" @bind-Text=currentMajor.NombreCarrera />
                    </Field>
                </Validation>
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="facultadAsociada">Facultad asociada</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="facultadAsociada" @bind-SelectedValue=currentMajor.FacultadId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var f in facultades)
                            {
                                <SelectItem TValue="Guid" Value="@f.Id">
                                    @f.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
            </Validations>
        </fieldset>
    </Form>

    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="submit">
            @buttonText
        </Button>
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="goBack">
            Cancelar
        </Button>
    </Div>

</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, false)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessageAndRedirectViewPage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, true)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>


@code {
    [Parameter]
    public Guid? majorId { get; set; }

    private List<FacultadComboDTO> facultades = new();

    private Major currentMajor = new();
    private string pageTitle = "";
    private string buttonText = "";

    private Validations validations;

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    private Modal modalToShowErrorMessageAndRedirectViewPage;

    private void ValidateGuidSelection(ValidatorEventArgs e)
    {
        if (e.Value is Guid guid && guid == Guid.Empty)
        {
            e.Status = ValidationStatus.Error;
        }
        else
        {
            e.Status = ValidationStatus.Success;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            facultades = await FacultadApiService.GetComboAsync();

            if (majorId is not null && majorId != Guid.Empty)
            {
                var responseToGetId = await CarreraApiService.GetByIdAsync(majorId.Value);

                if (!responseToGetId.Success)
                {
                    switch (responseToGetId.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();

                            break;

                        default:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                var dto = responseToGetId.Data;
                
                currentMajor = new Major
                {
                    Id = dto!.Id,
                    NombreCarrera = dto.NombreCarrera,
                    FacultadId = dto.FacultadId,
                };

                pageTitle = "Editar directriz";
                buttonText = "Actualizar";
            }
            else
            {
                currentMajor = new Major();
                pageTitle = "Crear directriz";
                buttonText = "Crear";
            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessageAndRedirectViewPage.Show();
        } 
        finally
        {
            isLoading = false;
        }
    }

    private async Task submit()
    {
        if (await validations.ValidateAll())
        {
            await saveMajor();
        }
    }

    private async Task saveMajor()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var dto = new CarreraCreateUpdateDto
            {
                NombreCarrera = currentMajor.NombreCarrera,
                FacultadId = currentMajor.FacultadId,
            };

            if (majorId is null || majorId == Guid.Empty){
                var response = await CarreraApiService.CreateAsync(dto);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }
            else
            {
                var response = await CarreraApiService.UpdateAsync(currentMajor.Id, dto);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.NotFound:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }
                
            NavManager.NavigateTo("/home/vistaCarreras");
        }
        finally
        {
            isLoading = false;
        }
        
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaCarreras");
    }

    private Task HideModal(Modal modal, bool value)
    {
        if (value)
        {
            NavManager.NavigateTo("/home/vistaCarreras");
            return modal.Hide();
        }
        else
        {
            return modal.Hide();
        }
    }
}
