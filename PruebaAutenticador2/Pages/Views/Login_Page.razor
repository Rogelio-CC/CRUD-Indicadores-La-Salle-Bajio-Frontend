<!-- Ruta de la interfaz. -->
@page "/"

<!-- Importación de librerías/servicios. -->
@inject NavigationManager NavManager;
@inject AuthenticationStateProvider AuthProvider;

<!-- Importaciones de estilos CSS. -->
<link rel="stylesheet" href="css/LoginPage.css"/>
<link rel="stylesheet" href="css/fonts.css"/>

<!-- Título principal de la pestaña. -->
<PageTitle>Inicio de sesión</PageTitle>

<!-- Contenedor principal. -->
<Div Class="login-page">
    <!-- Contenedor para los elementos del lado izquierdo. -->
    <Div Class="left-section">
        <!-- Imagen de fondo. -->
        <Div Class="background">
            <img src="Images/fondo_login.jpg" alt="Background" class="background-image" />
        </Div>
        <!-- Card que contiene el logo de la Salle y un título, al igual que un pequeño texto hasta el fondo de la card. -->
        <Div class="login-card-left">
            <img src="Images/logo_salle.png" alt="Logo Universidad La Salle" class="logo" />
            <h2 style="font-family:IndivisaFontBold">Gestión de indicadores</h2>
            <Login />
            <p class="footer-text" style="font-family:IndivisaFont">
                Universidad La Salle Bajío - Av. Universidad 602, Col. Lomas del Campestre, León, Gto. México. Tel (477) 10 85 00.<br>
                Todos los Derechos Reservados © @DateTime.Now.Year.
            </p>
        </Div>
    </Div>

    <!-- Contenedor para los elementos del lado derecho. -->
    <Div Class="right-section">
        <Div class="image-right">
            <img src="Images/FondoSalle.jpg" alt="Imagen derecha" />
        </Div>
    </Div>
</Div>

@code{

    // Al iniciar la página, se verifica si el usuario ya está autenticado. Si es así, se redirige automáticamente a la página de redirección.
    protected override async Task OnInitializedAsync()
    {
        // Se obtiene el estado de autenticación del usuario utilizando AuthenticationStateProvider.
        var authState = await AuthProvider.GetAuthenticationStateAsync();

        // Si el usuario ya está autenticado, se redirige a la página de redirección para evaluar a qué pantalla enviar al usuario.
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavManager.NavigateTo("/redirect");
        }
    }
}



