                </Card>
            </CardDeck>
        </Div>
    }
    else
    {
        <!--Si se logra llegar aquí sin un rol identificado, mandará este mensaje-->
        <Paragraph>No tienes los permisos necesarios para acceder.</Paragraph>
    }
    <!--Se llama al elemento .razor del footer en mayoría de las pantallas-->
    <PruebaAutenticador2.Pages.ReusableComponents.Footer />

</Layout>

@code {
    // Método para navegar a la pantalla correspondiente según el número de pantalla seleccionado en la interfaz principal.
    private void nextScreen(int screen)
    {

        switch (screen)
        {
            case 1:
                NavManager.NavigateTo("/home/vistaUsuarios");
                break;
            case 2:
                NavManager.NavigateTo("/home/vistaRoles");
                break;
            case 3:
                NavManager.NavigateTo("/home/vistaFacultades");
                break;
            case 4:
                NavManager.NavigateTo("/home/vistaCarreras");
                break;
            case 5:
                NavManager.NavigateTo("/home/vistaDirectrices");
                break;
            case 6:
                NavManager.NavigateTo("/home/vistaIndicadores");
                break;
            case 7:
                NavManager.NavigateTo("/home/vistaEstrategias");
                break;
            case 8:
                NavManager.NavigateTo("/home/vistaActividades");
                break;
            case 9:
                NavManager.NavigateTo("/home/vistaPeriodosEscolares");
                break;
            case 10:
                NavManager.NavigateTo("/home/vistaComentarios");
                break;
            default:
                break;


        }
    }
}

