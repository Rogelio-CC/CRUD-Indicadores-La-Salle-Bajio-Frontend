            <CardDeck>
                <Card @onclick="@(() => nextScreen(10))">
                    <CardBody>
                        <i class="icon fa fa-comments"></i>
                        <CardTitle Size="4">
                            Comentarios
                        </CardTitle>
                    </CardBody>
                </Card>
            </CardDeck>
        </Div>
