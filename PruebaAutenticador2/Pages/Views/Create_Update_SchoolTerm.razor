<!-- La estructura .razor de CreateUpdateSchoolTerm es la misma que CreateUpdateActivity,  por lo que se reutiliza varias partes de código de esa vista para esta. -->
@page "/home/vistaPeriodosEscolares/creacionPeriodoEscolar"
@page "/home/vistaPeriodosEscolares/creacionPeriodoEscolar/{schoolTermId:guid}"
@attribute [Authorize]

@inject NavigationManager NavManager
@using PruebaAutenticador2.Classes;
@using PruebaAutenticador2.Services;
@inject PeriodoEscolarApiService PeriodoEscolarApiService
@using System.ComponentModel.DataAnnotations
@inject AuthStateService AuthState
@using System.Net

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/AllForms.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<PageTitle>@pageTitle</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Período escolar</h1>

<Divider Class="separate-line-register" />

<Div Class="container-register">
    <Form>
        <fieldset class="form-grid">
            <Validations @ref="validations" Mode="ValidationMode.Auto" Model="currentSchoolTerm">
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="nombrePeriodoEscolar">Nombre del período escolar</FieldLabel>
                        <TextEdit Class="form-control" ElementId="nombrePeriodoEscolar" @bind-Text=currentSchoolTerm.Nombre />
                    </Field>
                </Validation>
                <Validation Validator="ValidateDateSelection">
                    <Field Class="form-field">
                        <FieldLabel For="fechaInicio">Fecha de inicio</FieldLabel>
                        <DateEdit TValue="DateTimeOffset" ElementId="fechaInicio" @bind-Date=currentSchoolTerm.FechaInicio />
                    </Field>
                </Validation>
                <Validation Validator="ValidateDateSelection">
                    <Field Class="form-field">
                        <FieldLabel For="fechaFinalizacion">Fecha de finalización</FieldLabel>
                        <DateEdit TValue="DateTimeOffset" ElementId="fechaFinalizacion" @bind-Date=currentSchoolTerm.FechaFin />
                    </Field>
                </Validation>
            </Validations>
        </fieldset>
    </Form>

    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="submit">
            @buttonText
        </Button>
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="goBack">
            Cancelar
        </Button>
    </Div>

</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;"><Paragraph Style="white-space: pre-line; text-align:center;">@errorMessage</Paragraph></Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, false)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessageAndRedirectViewPage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, true)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

@code {
    // La estructura de CreateUpdateSchoolTerm es la misma que CreateUpdateActivity, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    [Parameter]
    public Guid? schoolTermId { get; set; }

    private SchoolTerm currentSchoolTerm = new();
    private string pageTitle = "Crear período escolar";
    private string buttonText = "Crear";

    private Validations validations;

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    private Modal modalToShowErrorMessageAndRedirectViewPage;

    private void ValidateDateSelection(ValidatorEventArgs e)
    {
        if (e.Value is DateTimeOffset date)
        {
            var now = DateTimeOffset.Now.Date;

            if (date < now || date > now.AddYears(1))
            {
                e.Status = ValidationStatus.Error;
            }
            else
            {
                e.Status = ValidationStatus.Success;
            }
        }
    }



    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (schoolTermId is not null && schoolTermId != Guid.Empty)
            {
                var schoolTermFromApi = await PeriodoEscolarApiService.GetByIdAsync(schoolTermId.Value);

                if (!schoolTermFromApi.Success)
                {
                    switch (schoolTermFromApi.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = schoolTermFromApi.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();

                            break;

                        default:
                            errorMessage = schoolTermFromApi.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                if (schoolTermFromApi != null)
                {
                    currentSchoolTerm = schoolTermFromApi.Data!;
                    pageTitle = "Editar período escolar";
                    buttonText = "Actualizar";
                }
            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessageAndRedirectViewPage.Show();
        }  
        finally
        {
            isLoading = false;
        }
    }

    async Task submit()
    {
        if (await validations.ValidateAll())
        {
            await saveSchoolTerm();
        }
    }

    private async Task saveSchoolTerm()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (schoolTermId is null || schoolTermId == Guid.Empty)
            {
                var response = await PeriodoEscolarApiService.CreateAsync(currentSchoolTerm);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = "• El nombre del período debe tener entre 5 y 100 caracteres.\n\n" +
                            "• Las fechas no deben ser anteriores al actual ni mayor a 1 año.";
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }
            else
            {
                var response = await PeriodoEscolarApiService.UpdateAsync(currentSchoolTerm.Id, currentSchoolTerm);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = "• El nombre del período debe tener entre 5 y 100 caracteres.\n\n" +
                            "• Las fechas no deben ser anteriores al actual ni mayor a 1 año.\n\n" +
                            "• También puede ser que el ID no coincida.";
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.NotFound:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }

            NavManager.NavigateTo("/home/vistaPeriodosEscolares");

        } finally
        {
            isLoading = false;
        }
        
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaPeriodosEscolares");
    }

    private Task HideModal(Modal modal, bool value)
    {
        if (value)
        {
            NavManager.NavigateTo("/home/vistaPeriodosEscolares");
            return modal.Hide();
        }
        else
        {
            return modal.Hide();
        }
    }
}
