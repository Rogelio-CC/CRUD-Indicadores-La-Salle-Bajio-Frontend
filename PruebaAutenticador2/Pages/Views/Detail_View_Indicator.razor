<!-- La estructura .razor de DetailViewIndicator es la misma que DetailViewActivity,  por lo que se reutiliza varias partes de código de esa vista para esta.-->
@page "/home/vistaIndicadores/detalleIndicador/{indicatorId:guid}"
@attribute [Authorize]

@inject NavigationManager NavManager
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services;
@using PruebaAutenticador2.Shared.DTOS.Indicador;
@using PruebaAutenticador2.Shared.DTOS.Evidencia;
@inject IndicadorApiService IndicadorApiService
@inject EvidenciaApiService EvidenciaApiService
@inject AuthStateService AuthState
@inject IJSRuntime JS
@using System.Net

<link rel="stylesheet" href="css/DetailV.css" />
<link rel="stylesheet" href="css/ViewEvidences.css" />
<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/Footer.css" />
<link rel="stylesheet" href="css/Fonts.css" />

<PageTitle>Detalle del indicador</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Detalles del indicador</h1>

<Divider Class="separate-line-detail" />

<Div Class="container-detail">
    <Form>
        <fieldset class="form-grid">
            <!-- Fila 1 -->
            <Field Class="form-field">
                <FieldLabel For="descripcion">Descripción</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.DescripcionIndicador" ReadOnly="true" ElementId="descripcion" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="controlDeFrecuencia">Control de frecuencia</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.FrecuenciaControl" ReadOnly="true" ElementId="controlDeFrecuencia" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="estandar">Estándar</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.Estandar.ToString()" ReadOnly="true" ElementId="controlDeFrecuencia" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="directrizaAsociado">Directriz asociado</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.Directriz" ReadOnly="true" ElementId="directrizaAsociado" />
            </Field>

            <!-- Fila 2 -->
            <Field Class="form-field">
                <FieldLabel For="grupoAsociado">Grupo asociado</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.Grupo" ReadOnly="true" ElementId="grupoAsociado" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="creadorAsociado">Creador asociado</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.Creador" ReadOnly="true" ElementId="creadorAsociado" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="fechaDecreacion">Fecha de creación</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.FechaEmision.ToString("dd/MM/yyyy")" ReadOnly="true" ElementId="fechaDecreacion" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="fechaDeCumplimiento">Fecha de cumplimiento</FieldLabel>
                <TextEdit Class="form-control"
                          Text="@(currentIndicator.FechaCumplimiento.HasValue ? currentIndicator.FechaCumplimiento.Value.ToString("dd/MM/yyyy") : "")"
                          ReadOnly="true"
                          ElementId="fechaDeCumplimiento" />
            </Field>

            <!-- Fila 3 -->
            <Field Class="form-field">
                <FieldLabel For="periodoEscolarAsociado">Período Escolar asociado</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.Periodo" ReadOnly="true" ElementId="periodoEscolarAsociado" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="carreraAsociada">Carrera asociada</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.Carrera" ReadOnly="true" ElementId="carreraAsociada" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="cantidadEvidenciasNecesarias">Cantidad de evidencias necesarias</FieldLabel>
                <TextEdit Class="form-control" Text="@currentIndicator.CantidadEvidencias.ToString()" ReadOnly="true" ElementId="cantidadEvidenciasNecesarias" />
            </Field>

            <!-- Fila 4 -->
            <Field Class="form-field">
                <FieldLabel For="indicadorCumplido">¿Se cumplió el indicador?</FieldLabel>
                <TextEdit Class="form-control" Text="@(currentIndicator.IndicadorCompletado ? "Sí" : "No")" ReadOnly="true" ElementId="indicadorCumplido" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="accionCorrectiva">Acción correctiva</FieldLabel>
                <TextEdit Class="form-control" Text="@(currentIndicator.AccionCorrectiva ?? "")" ReadOnly="true" ElementId="accionCorrectiva" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="resopnsableAC">Responsable de la acción correctiva</FieldLabel>
                <TextEdit Class="form-control" Text="@(currentIndicator.ResponsableAccionCorrectiva ?? "")" ReadOnly="true" ElementId="resopnsableAC" />
            </Field>
        </fieldset>
        <!-- Lista de las evidencias que estan subidas al indicador actual mostrado -->
        <Field Class="container-evidencias">
            <FieldLabel Class="label-evidencias" For="evidencias">Evidencias</FieldLabel>
            @if (evidencias.Any())
            {
                <ul class="list-evidencias">
                    @foreach (var evidencia in evidencias)
                    {
                        <li class="item-evidencia">
                            <i class="bi bi-file-earmark-text-fill" style="color:#002855; margin-right:6px;"></i>
                            <Button Clicked="() => DownloadEvidence(evidencia)">
                                @evidencia.NombreArchivo
                            </Button>
                            <span class="tipo-evidencia">(@evidencia.Tipo)</span>
                        </li>
                    }
                </ul>

                <p class="estado-evidencias">
                    <!-- Mensaje en caso de que faltan evidencias por subir para completar el indicador -->
                    @if (evidencias.Count < currentIndicator.CantidadEvidencias)
                    {
                        <span style="color: #b22222;">⚠️ Faltan @(currentIndicator.CantidadEvidencias - evidencias.Count) evidencias por completar.</span>
                    }
                    else
                    {
                        <span style="color: #2e8b57;">✅ Se han completado todas las evidencias requeridas.</span>
                    }
                </p>
            }
            else
            {
                <p style="color: #b22222;">No se han subido evidencias aún.</p>
            }
        </Field>
    </Form>
    
    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                       background-color: #002855;
                       color: #ffffff;
                       width:96%;
                       box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                       text-transform: uppercase;"
                Clicked="goBack">
            Regresar
        </Button>
    </Div>
</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

@code {
    // La estructura de DetailViewIndicator es la misma que DetailViewActivity, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    [Parameter]
    public Guid? indicatorId { get; set; }

    private Indicator currentIndicator = new();
    private List<EvidenciaDto> evidencias = new();

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (indicatorId is not null && indicatorId != Guid.Empty)
            {
                var responseToGetId = await IndicadorApiService.GetByIdAsync(indicatorId.Value);

                if (!responseToGetId.Success)
                {
                    switch (responseToGetId.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;
                    }

                    return;
                }

                var dto = responseToGetId.Data;
            
                currentIndicator = new Indicator
                {
                    Id = dto!.Id,
                    DescripcionIndicador = dto.DescripcionIndicador,
                    Estandar = dto.Estandar,
                    FrecuenciaControl = dto.FrecuenciaControl,
                    CantidadEvidencias = dto.CantidadEvidencias,
                    IndicadorCompletado = dto.IndicadorCompletado,
                    AccionCorrectiva = dto.AccionCorrectiva,
                    FechaEmision = dto.FechaEmision,
                    FechaCumplimiento = dto.FechaCumplimiento,
                    DirectrizId = dto.DirectrizId,
                    Directriz = dto.Directriz,
                    GrupoId = dto.GrupoId,
                    Grupo = dto.Grupo,
                    CreadorId = dto.CreadorId,
                    Creador = dto.Creador,
                    ResponsableAccionCorrectivaId = dto.ResponsableAccionCorrectivaId,
                    ResponsableAccionCorrectiva = dto.ResponsableAccionCorrectiva,
                    PeriodoId = dto.PeriodoId,
                    Periodo = dto.Periodo,
                    CarreraId = dto.CarreraId,
                    Carrera = dto.Carrera,
                };
            
                var responseToGetEvidencias = await EvidenciaApiService.GetAllAsync(currentIndicator.Id);

                if (!responseToGetEvidencias.Success)
                {
                    switch (responseToGetEvidencias.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = responseToGetEvidencias.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = responseToGetEvidencias.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;
                    }

                    return;
                }

                evidencias = responseToGetEvidencias.Data!;
            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }
    }

    // El método DownloadEvidence se encarga de descargar la evidencia seleccionada por el usuario. 
    // Para esto, se hace una petición al backend para obtener el archivo en bytes, y luego se utiliza JavaScript interop para descargar el archivo en el navegador del usuario.
    private async Task DownloadEvidence(EvidenciaDto evidencia)
    {
        var bytes = await EvidenciaApiService.DownloadAsync(
            currentIndicator.Id,
            evidencia.Id
        );

        // Se llama a la función JavaScript "downloadFile" que se encuentra en el archivo wwwroot/js/download.js, 
        // pasando el nombre del archivo, el tipo y los bytes para que el navegador pueda descargarlo.
        await JS.InvokeVoidAsync(
            "downloadFile",
            evidencia.NombreArchivo,
            evidencia.Tipo,
            bytes
        );
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaIndicadores");

    }

    private Task HideModal(Modal modal)
    {
        NavManager.NavigateTo("/home/vistaIndicadores");
        return modal.Hide();
    }
}
