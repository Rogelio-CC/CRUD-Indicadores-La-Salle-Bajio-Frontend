<!-- La estructura .razor de CRUDFaculties es la misma que CRUDActivities,  por lo que se reutiliza varias partes de código de esa vista para esta. -->
@page "/home/vistaFacultades"
@attribute [Authorize]

@inject NavigationManager NavManager
@inject FacultadApiService FacultadApiService
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@inject AuthStateService AuthState

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/Tables.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<PageTitle>Lista de facultades</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<Div Class="header-section">
    <h1 class="title-general">Lista de facultades</h1>
    <Div Class="header-buttons">
        <Button Class="add-button" Clicked="@addFaculty">
            Agregar facultad
        </Button>
        <Button Class="add-button" Clicked="@goBack">
            Regresar al inicio
        </Button>
    </Div>
</Div>

<Divider Class="separate-line" />

<Div Class="search-container">
    <Span Class="search-icon">
        <i class="fas fa-search"></i>
    </Span>
    <TextEdit Placeholder="Busca por nombre" Class="search-bar" Text="@searchText" TextChanged="@OnSearchChanged" />
</Div>

<Div Class="table-container">
    <Table Bordered ResponsiveMode="TableResponsiveMode.Mobile" align="left" Class="all-table">
        <TableHeader>
            <TableRow>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Nombre de la facultad
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Fecha de creación
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Fecha de edición
                </TableHeaderCell>
                <TableHeaderCell Style="background-color: #002855; color: #ffffff; text-align: center; font-weight: bold;">
                    Acciones
                </TableHeaderCell>
            </TableRow>
        </TableHeader>
        <TableBody>
            @foreach (var faculty in filteredFaculties)
            {
                <TableRow>
                    <TableRowCell MobileModeCaption="Nombre de la facultad">@faculty.Nombre</TableRowCell>
                    <TableRowCell MobileModeCaption="Fecha de creación">@faculty.FechaEmision.ToString("dd/MM/yyyy")</TableRowCell>
                    <TableRowCell MobileModeCaption="Fecha de edición"> @(faculty.FechaEdicion?.ToString("dd/MM/yyyy") ?? "No hay fecha")</TableRowCell>
                    <TableRowCell>
                        <Div Class="buttons-container">
                            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Clicked="() => viewFaculty(faculty.Id)">
                                Detalles
                            </Button>
                            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-left: 15px;" Clicked="() => editFaculty(faculty.Id)">
                                Editar
                            </Button>
                            <Button Style="font-family:IndivisaFont; background-color: #CF152D; color: #ffffff; margin-left: 15px;" Clicked="() => confirmDelete(faculty.Id)">
                                Eliminar
                            </Button>
                        </Div>
                    </TableRowCell>
                </TableRow>
            }
        </TableBody>
    </Table>
</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="modalRef">
    <ModalContent Centered>
        <ModalHeader Style="background-color: #002855;">
            <ModalTitle Style="font-family:IndivisaFontBold; color: #ffffff;">Eliminación de una facultad</ModalTitle>
            <CloseButton Style="background-color: #ffffff; opacity: 1;" />
        </ModalHeader>
        <ModalBody>
            <Field>
                <FieldLabel Style="font-family:IndivisaFont;">¿Quieres eliminar esta facultad?</FieldLabel>
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff;" Clicked="() => HideModal(modalRef)">No</Button>
            <Button Style="font-family:IndivisaFont; background-color: #CF152D; color: #ffffff;" Clicked="@deleteFaculty">Si</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>


@code {
    // La estructura de CRUDFaculties es la misma que CRUDActivities, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    private List<Faculty> facultyList = new();

    private string searchText = string.Empty;
    private List<Faculty> filteredFaculties = new();

    private bool isLoading = false;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadFaculties();
    }

    private async Task LoadFaculties()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await FacultadApiService.GetAllAsync();

            facultyList = response.Data!.OrderBy(r => r.Nombre).ToList();

            filteredFaculties = facultyList;

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;   
        }
        
    }

    private void OnSearchChanged(string value)
    {
        searchText = value;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredFaculties = facultyList;
        }
        else
        {
            filteredFaculties = facultyList
                .Where(a =>
                    a.Nombre.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }


    private void addFaculty()
    {
        NavManager.NavigateTo("/home/vistaFacultades/creacionFacultad");
    }

    private Guid facultyToDelete;

    private void viewFaculty(Guid id)
    {
        NavManager.NavigateTo($"/home/vistaFacultades/detalleFacultad/{id}");
    }

    private void editFaculty(Guid id)
    {
        NavManager.NavigateTo($"/home/vistaFacultades/creacionFacultad/{id}");
    }

    private Task confirmDelete(Guid id)
    {
        facultyToDelete = id;
        return modalRef.Show();
    }

    private async Task deleteFaculty()
    {
        var response = await FacultadApiService.DeleteAsync(facultyToDelete);

        if (!response.Success)
        {
            errorMessage = response.ErrorMessage ?? "No se pudo eliminar la facultad";
            modalToShowErrorMessage?.Show();
            return;
        }

        await LoadFaculties();
        await modalRef.Hide();
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home");
    }

    private Modal modalRef;
    private Modal modalToShowErrorMessage;

    private Task HideModal(Modal modal)
    {
        return modal.Hide();
    }

}

