<!-- La estructura .razor de CreateUpdateGroupOfIndicator es la misma que CreateUpdateActivity,  por lo que se reutiliza varias partes de código de esa vista para esta. -->
@page "/home/vistaIndicadores/vistaGruposIndicadores/creacionGrupoIndicadores"
@page "/home/vistaIndicadores/vistaGruposIndicadores/creacionGrupoIndicadores/{GOIsId:guid}"
@attribute [Authorize]

@inject NavigationManager NavManager
@inject GrupoIndicadoresApiService GrupoIndicadoresApiService
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services;
@using System.ComponentModel.DataAnnotations
@inject AuthStateService AuthState
@using System.Net

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/AllForms.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<PageTitle>@pageTitle</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Grupo de indicadores</h1>

<Divider Class="separate-line-register" />

<Div Class="container-register">
    <Form>
        <fieldset class="form-grid">
            <Validations @ref="validations" Mode="ValidationMode.Auto" Model="currentGroupOfIndicators">
                <Validation Validator="ValidationRule.IsSelected">
                    <Field Class="form-field">
                        <FieldLabel For="numeroDelGrupo">Número del grupo</FieldLabel>
                        <NumericEdit Class="form-control" ElementId="numeroDelGrupo" @bind-Value=currentGroupOfIndicators.NumeroGrupo />
                    </Field>
                </Validation>
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="descripcion">Descripción</FieldLabel>
                        <TextEdit Class="form-control" ElementId="descripcion" @bind-Text=currentGroupOfIndicators.DescripcionGrupo />
                    </Field>
                </Validation>
            </Validations>
        </fieldset>
    </Form>

    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="submit">
            @buttonText
        </Button>
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="goBack">
            Cancelar
        </Button>
    </Div>

</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;"><Paragraph Style="white-space: pre-line; text-align:center;">@errorMessage</Paragraph></Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, false)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessageAndRedirectViewPage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, true)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

@code {
    // La estructura de CreateUpdateComment es la misma que CreateUpdateActivity, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    [Parameter]
    public Guid? GOIsId { get; set; }

    private GroupOfIndicators currentGroupOfIndicators = new();
    private string pageTitle = "Crear grupo de indicadores";
    private string buttonText = "Crear";

    private Validations validations;

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    private Modal modalToShowErrorMessageAndRedirectViewPage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (GOIsId is not null && GOIsId != Guid.Empty)
            {
                var GOISFromApi = await GrupoIndicadoresApiService.GetByIdAsync(GOIsId.Value);

                if (!GOISFromApi.Success)
                {
                    switch (GOISFromApi.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = GOISFromApi.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();

                            break;

                        default:
                            errorMessage = GOISFromApi.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                if (GOISFromApi != null)
                {
                    currentGroupOfIndicators = GOISFromApi.Data!;
                    pageTitle = "Editar grupo de indicadores";
                    buttonText = "Actualizar";
                }

            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessageAndRedirectViewPage.Show();
        }  
        finally
        {
            isLoading = false;
        }
    }

    private async Task submit()
    {
        if (await validations.ValidateAll())
        {
            await saveGroupOfIndicators();
        }
    }

    private async Task saveGroupOfIndicators()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (GOIsId is null || GOIsId == Guid.Empty)
            {
                var response = await GrupoIndicadoresApiService.CreateAsync(currentGroupOfIndicators);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = "• Los campos del grupo no deben quedar vacios.\n\n" + 
                            "• El número del grupo no debe ser negativo. \n\n" + 
                            "• El nombre del grupo debe tener al menos 5 caracteres y no debe superar los 100 caracteres.";
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }
            else
            {
                var response = await GrupoIndicadoresApiService.UpdateAsync(currentGroupOfIndicators.Id, currentGroupOfIndicators);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = errorMessage = "• Los campos del grupo no deben quedar vacios.\n\n" +
                            "• El número del grupo no debe ser negativo. \n\n" +
                            "• El nombre del grupo debe tener al menos 5 caracteres y no debe superar los 100 caracteres. \n\n" + 
                            "• También puede ser que el ID no coincida.";
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.NotFound:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }

            NavManager.NavigateTo("/home/vistaIndicadores/vistaGruposIndicadores");
        }
        finally
        {
            isLoading = false;
        }
        
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaIndicadores/vistaGruposIndicadores");
    }

    private Task HideModal(Modal modal, bool value)
    {
        if (value)
        {
            NavManager.NavigateTo("/home/vistaIndicadores/vistaGruposIndicadores");
            return modal.Hide();
        }
        else
        {
            return modal.Hide();
        }
    }
}

