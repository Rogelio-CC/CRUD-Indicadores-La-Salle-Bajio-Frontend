<!-- La estructura .razor de CreateUpdateGuideline es la misma que CreateUpdateActivity,  por lo que se reutiliza varias partes de código de esa vista para esta. -->
@page "/home/vistaDirectrices/creacionDirectriz"
@page "/home/vistaDirectrices/creacionDirectriz/{guidelineId:guid}"
@attribute [Authorize]

@inject NavigationManager NavManager
@using PruebaAutenticador2.Classes;
@using PruebaAutenticador2.Services;
@using System.ComponentModel.DataAnnotations;
@using PruebaAutenticador2.Shared.DTOS.Directriz;
@using PruebaAutenticador2.Shared.DTOS.ListaCombos;
@inject DirectrizApiService DirectrizApiService;
@inject UsuarioApiService UsuarioApiService
@inject FacultadApiService FacultadApiService
@inject PeriodoEscolarApiService PeriodoEscolarApiService
@inject ComentarioApiService ComentarioApiService
@inject AuthStateService AuthState
@using System.Net

<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/AllForms.css" />
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/Footer.css" />

<PageTitle>@pageTitle</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Directriz</h1>

<Divider Class="separate-line-register" />

<Div Class="container-register">
    <Form>
        <fieldset class="form-grid">
            <Validations @ref="validations" Mode="ValidationMode.Auto" Model="currentGuideline">
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field Class="form-field">
                        <FieldLabel For="descripcion">Descripción</FieldLabel>
                        <TextEdit Class="form-control" ElementId="descripcion" @bind-Text=currentGuideline.Descripcion />
                    </Field>
                </Validation>
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="creadorAsociado">Creador asociado</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="creadorAsociado" @bind-SelectedValue=currentGuideline.CreadorId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var u in usuarios)
                            {
                                <SelectItem TValue="Guid" Value="@u.Id">
                                    @u.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="facultadAsociada">Facultad asociada</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="facultadAsociada" @bind-SelectedValue=currentGuideline.FacultadId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var f in facultades)
                            {
                                <SelectItem TValue="Guid" Value="@f.Id">
                                    @f.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="periodoEscolarAsociado">Período escolar asociado</FieldLabel>
                        <Select Class="form-select" TValue="Guid" ElementId="periodoEscolarAsociado" @bind-SelectedValue=currentGuideline.PeriodoId>
                            <SelectItem TValue="Guid" Value="Guid.Empty">Selecciona alguna de las opciones</SelectItem>
                            @foreach (var pe in periodos)
                            {
                                <SelectItem TValue="Guid" Value="@pe.Id">
                                    @pe.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
                <Validation Validator="ValidateGuidSelection">
                    <Field Class="form-field">
                        <FieldLabel For="comentarioAsociado">Comentario asociado (una vez cambiado el valor "Ninguno" ya pedirá un comentario forzosamente. Si no se necesita uno, dejar el valor predeterminado)</FieldLabel>
                        <Select Class="form-select" TValue="Guid?" ElementId="comentarioAsociado" @bind-SelectedValue=currentGuideline.ComentarioId>
                        <SelectItem TValue="Guid?" Value="Guid.Empty">Ninguno</SelectItem>
                            @foreach (var co in comentarios)
                            {
                                <SelectItem TValue="Guid" Value="@co.Id">
                                    @co.Nombre
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Validation>
            </Validations>
        </fieldset>
    </Form>

    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="submit">
            @buttonText
        </Button>
        <Button Style="font-family:IndivisaFont;
                   background-color: #002855;
                   color: #ffffff;
                   width:50%;
                   box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                   text-transform: uppercase;"
                Clicked="goBack">
            Cancelar
        </Button>
    </Div>

</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, false)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="@modalToShowErrorMessageAndRedirectViewPage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage, true)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

@code {
    // La estructura de CreateUpdateComment es la misma que CreateUpdateActivity, por lo que se reutiliza varias partes de código de esa vista para esta,
    //  como la validación del Guid, el manejo de errores, entre otros.
    [Parameter]
    public Guid? guidelineId { get; set; }

    private List<UsuarioComboDTO> usuarios = new();
    private List<FacultadComboDTO> facultades = new();
    private List<PeriodoEscolarComboDTO> periodos = new();
    private List<ComentarioComboDTO> comentarios = new();

    private Guideline currentGuideline = new();
    private string pageTitle = "";
    private string buttonText = "";

    private Validations validations;

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    private Modal modalToShowErrorMessageAndRedirectViewPage;

    private void ValidateGuidSelection(ValidatorEventArgs e)
    {
        if (e.Value is Guid guid && guid == Guid.Empty)
        {
            e.Status = ValidationStatus.Error;
        }
        else
        {
            e.Status = ValidationStatus.Success;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            usuarios = await UsuarioApiService.GetComboAsync();
            facultades = await FacultadApiService.GetComboAsync();
            periodos = await PeriodoEscolarApiService.GetComboAsync();
            comentarios = await ComentarioApiService.GetComboAsync();

            if (guidelineId is not null && guidelineId != Guid.Empty)
            {
                var responseToGetId = await DirectrizApiService.GetByIdAsync(guidelineId.Value);

                if (!responseToGetId.Success)
                {
                    switch (responseToGetId.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();

                            break;

                        default:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }

                var dto = responseToGetId.Data;

                currentGuideline = new Guideline
                {
                    Id = dto!.Id,
                    Descripcion = dto.Descripcion,
                    FacultadId = dto.FacultadId,
                    CreadorId = dto.CreadorId,
                    PeriodoId = dto.PeriodoId,
                    ComentarioId = dto.ComentarioId,
                };

                pageTitle = "Editar directriz";
                buttonText = "Actualizar";
            }
            else
            {
                currentGuideline = new Guideline();
                pageTitle = "Crear directriz";
                buttonText = "Crear";
            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessageAndRedirectViewPage.Show();
        } 
        finally
        {
            isLoading = false;
        }
    }


    private async Task submit()
    {
        if (await validations.ValidateAll())
        {
            await saveGuideline();
        }
    }


    private async Task saveGuideline()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var dto = new DirectrizCreateUpdateDto
            {
                Descripcion = currentGuideline.Descripcion,
                FacultadId = currentGuideline.FacultadId,
                CreadorId = currentGuideline.CreadorId,
                PeriodoId = currentGuideline.PeriodoId,
                ComentarioId = currentGuideline.ComentarioId,
            };

            if (guidelineId is null || guidelineId == Guid.Empty){
                var response = await DirectrizApiService.CreateAsync(dto);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }
            else{

                var response = await DirectrizApiService.UpdateAsync(currentGuideline.Id, dto);

                if (!response.Success)
                {
                    switch (response.StatusCode)
                    {
                        case HttpStatusCode.BadRequest:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.Conflict:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        case HttpStatusCode.NotFound:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        case HttpStatusCode.Forbidden:
                            errorMessage = "No puedes modificar ni eliminar directrices que no son de tu propiedad.";
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;

                        default:
                            errorMessage = response.ErrorMessage;
                            await modalToShowErrorMessageAndRedirectViewPage.Show();
                            break;
                    }

                    return;
                }
            }
                

            NavManager.NavigateTo("/home/vistaDirectrices");

        }
        finally
        {
            isLoading = false;
        }
        
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaDirectrices");
    }

    private Task HideModal(Modal modal, bool value)
    {
        if (value)
        {
            NavManager.NavigateTo("/home/vistaDirectrices");
            return modal.Hide();
        }
        else
        {
            return modal.Hide();
        }
    }
}
