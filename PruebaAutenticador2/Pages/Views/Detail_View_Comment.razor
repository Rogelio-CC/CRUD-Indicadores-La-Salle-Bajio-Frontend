@page "/home/vistaComentarios/detalleComentario/{commentId:guid}"
@attribute [Authorize]
@inject NavigationManager NavManager
@inject ComentarioApiService ComentarioApiService
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@inject AuthStateService AuthState
@using System.Net

<link rel="stylesheet" href="css/DetailV.css" />
<link rel="stylesheet" href="css/Nabvar.css" />
<link rel="stylesheet" href="css/Footer.css" />
<link rel="stylesheet" href="css/Fonts.css" />

<PageTitle>Detalle del comentario</PageTitle>

<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<h1>Detalles del comentario</h1>

<Divider Class="separate-line-detail" />

<Div Class="container-detail">
    <Form>
        <fieldset class="form-grid">
            <!-- Fila 1 -->
            <Field Class="form-field">
                <FieldLabel For="contenido">Contenido</FieldLabel>
                <TextEdit Class="form-control" Text="@currentComment.Contenido" ReadOnly="true" ElementId="contenido" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="creadorAsociado">Creador asociado</FieldLabel>
                <TextEdit Class="form-control" Text="@currentComment.Creador" ReadOnly="true" ElementId="creadorAsociado" />
            </Field>

            <!-- Fila 2 -->
            <Field Class="form-field">
                <FieldLabel For="fechaDeCreacion">Fecha de creación</FieldLabel>
                <TextEdit Class="form-control" Text="@currentComment.FechaComentario.ToString("dd/MM/yyyy")" ReadOnly="true" ElementId="fechaDeCreacion" />
            </Field>
            <Field Class="form-field">
                <FieldLabel For="tipoDeObjetivo">Tipo de objetivo</FieldLabel>
                <TextEdit Class="form-control" Text="@currentComment.TipoObjetivo" ReadOnly="true" ElementId="tipoDeObjetivo" />
            </Field>
        </fieldset>
    </Form>
    
    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                       background-color: #002855;
                       color: #ffffff;
                       width:96%;
                       box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                       text-transform: uppercase;"
                Clicked="goBack">
            Cancelar
        </Button>
    </Div>
</Div>

<PruebaAutenticador2.Pages.ReusableComponents.Footer />

@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>


@code {
    [Parameter]
    public Guid? commentId { get; set; }

    private Comment currentComment = new();

    private bool isLoading = false;

    private string? errorMessage;

    private Modal modalToShowErrorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (commentId is not null && commentId != Guid.Empty)
            {
                var responseToGetId = await ComentarioApiService.GetByIdAsync(commentId.Value);

                if (!responseToGetId.Success)
                {
                    switch (responseToGetId.StatusCode)
                    {
                        case HttpStatusCode.NotFound:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;

                        default:
                            errorMessage = responseToGetId.ErrorMessage;
                            await modalToShowErrorMessage.Show();
                            break;
                    }

                    return;
                }

                var dto = responseToGetId.Data;

                currentComment = new Comment
                {
                    Id = dto!.Id,
                    Contenido = dto.Contenido,
                    FechaComentario = dto.FechaComentario,
                    TipoObjetivo = dto.TipoObjetivo,
                    IdObjetivo = dto.IdObjetivo,
                    CreadorId = dto.CreadorId,
                    Creador = dto.Creador
                };
            }

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void goBack()
    {
        NavManager.NavigateTo("/home/vistaComentarios");

    }

    private Task HideModal(Modal modal)
    {
        NavManager.NavigateTo("/home/vistaComentarios");
        return modal.Hide();
    }
}
