<!--Ruta de la interfaz-->
@page "/home/vistaIndicadores/vistaGruposIndicadores/vistaGraficas"
<!-- Se requiere que el usuario esté autenticado para acceder a esta página -->
@attribute [Authorize]

<!--Importación de librerías/servicios-->
@inject NavigationManager NavManager
@inject IndicadorApiService IndicadorApiService
@inject GrupoIndicadoresApiService GrupoIndicadoresApiService
@using PruebaAutenticador2.Classes
@using PruebaAutenticador2.Services
@using PruebaAutenticador2.Shared.DTOS.Indicador
@using PruebaAutenticador2.Shared.DTOS.ListaCombos
@inject AuthStateService AuthState

<!--Importaciones de estilos CSS-->
<link rel="stylesheet" href="css/GraphSearch.css" />
<link rel="stylesheet" href="css/Nabvar.css" />
<Link rel="stylesheet" href="~/css/Fonts.css"/>
<link rel="stylesheet" href="css/Footer.css" />

<!--Título principal de la pestaña-->
<PageTitle>Búsqueda de Gráficas</PageTitle>

<!--Se llama al elemento .razor del navbar en mayoría de las pantallas-->
<PruebaAutenticador2.Pages.ReusableComponents.Navbar role="@AuthState.Role" />

<!--Título principal de la pantalla-->
<h1>Gráficas generadas</h1>

<!--Línea de seperación entre el título de la página y el contenido-->
<Divider Class="separate-line-detail" />

<!--Contenedor del formulario para mostrar resultados de las gráficas-->
<Container Class="container-search">
    <Form>
        <fieldset class="form-search">
            <Field Class="form-field-search">
                <FieldLabel For="DescripcionGrupo">Descripción/Título del grupo de indicadores</FieldLabel>
                <Select TValue="Guid?" @bind-SelectedValue="selectedGrupoId" Class="form-select-search" ElementId="DescripcionGrupo">
                    <SelectItem Value=Guid.Empty>Ninguno</SelectItem>
                   
                    <!-- Se recorre la lista de indicadores para obtener los grupos existentes. Se agrupan por GrupoId y Grupo para evitar mostrar valores duplicados en la lista desplegable. -->
                    @foreach (var grupo in indicatorList
                                        .GroupBy(i => new { i.GrupoId, i.Grupo })
                                        .Select(g => g.Key))
                    {
                        <SelectItem Value="@grupo.GrupoId">
                            @grupo.Grupo
                        </SelectItem>
                    }
                </Select>
            </Field>
            <Field Class="form-field-search">
                <FieldLabel For="DirectrizAsociado">Directriz asociado</FieldLabel>
                <Select TValue="Guid?" @bind-SelectedValue="selectedDirectrizId" Class="form-select-search" ElementId="DirectrizAsociado">
                    <SelectItem Value=Guid.Empty>Ninguno</SelectItem>

                    <!-- Se recorre la lista de indicadores para obtener las directrices existentes. Se agrupan por DirectrizId y Directriz para evitar mostrar valores duplicados en la lista desplegable. -->
                    @foreach (var directriz in indicatorList
                                        .GroupBy(i => new { i.DirectrizId, i.Directriz })
                                        .Select(g => g.Key))
                    {
                        <SelectItem Value="@directriz.DirectrizId">
                            @directriz.Directriz
                        </SelectItem>
                    }
                </Select>
            </Field>
            <Field Class="form-field-search">
                <FieldLabel For="PeriodoEscolarAsociado">Periodo escolar asociado</FieldLabel>
                <Select TValue="Guid?" @bind-SelectedValue="selectedPeriodoId" Class="form-select-search" ElementId="PeriodoEscolarAsociado">
                    <SelectItem Value=Guid.Empty>Ninguno</SelectItem>

                    <!-- Se recorre la lista de indicadores para obtener los períodos escolares existentes. Se agrupan por PeriodoId y Periodo para evitar mostrar valores duplicados en la lista desplegable. -->
                    @foreach (var periodo in indicatorList
                                        .GroupBy(i => new { i.PeriodoId, i.Periodo })
                                        .Select(g => g.Key))
                    {
                        <SelectItem Value="@periodo.PeriodoId">
                            @periodo.Periodo
                        </SelectItem>
                    }
                </Select>
            </Field>
            <Field Class="form-field-search">
                <FieldLabel For="CarreraAsociada">Carrera asociada</FieldLabel>
                <Select TValue="Guid?" @bind-SelectedValue="selectedCarreraId" Class="form-select-search" ElementId="CarreraAsociada">
                    <SelectItem Value=Guid.Empty>Ninguno</SelectItem>

                    <!-- Se recorre la lista de indicadores para obtener las carreras existentes. Se agrupan por CarreraId y Carrera para evitar mostrar valores duplicados en la lista desplegable. -->
                    @foreach (var carrera in indicatorList
                                        .GroupBy(i => new { i.CarreraId, i.Carrera })
                                        .Select(g => g.Key))
                    {
                        <SelectItem Value="@carrera.CarreraId">
                            @carrera.Carrera
                        </SelectItem>
                    }
                </Select>
            </Field>
        </fieldset>
    </Form>
    <!-- Botón fuera del formulario -->
    <Div Class="form-submit">
        <Button Style="font-family:IndivisaFont;
                       background-color: #002855;
                       color: #ffffff;
                       width:96%;
                       box-shadow: 0 5px 10px 2px rgba(0, 0, 0, 0.15);
                       text-transform: uppercase;
                       margin-bottom: 30px;"
                Clicked="toSearchGraphics">
            Buscar
        </Button>
    </Div>
</Container>

<!--Contenedor del formulario para mostrar resultados de las gráficas-->
<Container Class="container-graphics">
    <Div Class="title-container">
        <h3 style="padding-top: 30px;">
            Resultados de la búsqueda
        </h3>
    </Div>
    <!--Si graficasCargadas es true, se cargan las gráficas-->
    @if (graficasCargadas)
    {
        <Div Class="dashboard-grid">

            <!-- CARD 1 -->
            <Div Class="dashboard-card">
                <!-- Título de la gráfica -->
                <Div Class="card-header">
                    Cantidad total de indicadores del grupo
                </Div>

                <!-- Tamaño, tipo y propiedades (Categoría y valor) de la gráfica -->
                <RadzenChart Style="height:260px;">
                    <RadzenColumnSeries Data="@totalIndicadoresPorGrupoData"
                                        CategoryProperty="Categoria"
                                        ValueProperty="Valor" />
                </RadzenChart>
            </Div>

            <!-- CARD 2 -->
            <Div Class="dashboard-card">
                <Div Class="card-header">
                    Cantidad total de indicadores cumplidos del grupo
                </Div>

                <RadzenChart Style="height:260px;">
                    <RadzenColumnSeries Data="@cumplimientoData"
                                     CategoryProperty="Categoria"
                                     ValueProperty="Valor">
                        <RadzenSeriesDataLabels Visible="true" />
                    </RadzenColumnSeries>
                </RadzenChart>
            </Div>

            <!-- CARD 3 -->
            <Div Class="dashboard-card">
                <Div Class="card-header">
                    Porcentaje de cumplimiento de los indicadores del grupo
                </Div>

                <RadzenChart Style="height:260px;">
                    <RadzenPieSeries Data="@porcentajeCumplimientoData"
                                     CategoryProperty="Categoria"
                                     ValueProperty="Valor">
                        <RadzenSeriesDataLabels Visible="true" />
                    </RadzenPieSeries>
                </RadzenChart>
            </Div>

            <!-- CARD 4 -->
            <Div Class="dashboard-card">
                <Div Class="card-header">
                    Cantidad total de indicadores del grupo por directriz
                </Div>

                <RadzenChart Style="height:260px;">
                    <RadzenColumnSeries Data="@totalIndicadoresGrupoPorDirectrizData"
                                        CategoryProperty="Categoria"
                                        ValueProperty="Valor">
                        <RadzenSeriesDataLabels Visible="true" />
                    </RadzenColumnSeries>
                </RadzenChart>
            </Div>

            <!-- CARD 5 -->
            <Div Class="dashboard-card">
                <Div Class="card-header">
                    Cantidad total de indicadores del grupo por periodo
                </Div>

                <RadzenChart Style="height:260px;">
                    <RadzenColumnSeries Data="@totalIndicadoresGrupoPorPeriodoData"
                                        CategoryProperty="Categoria"
                                        ValueProperty="Valor">
                        <RadzenSeriesDataLabels Visible="true" />
                    </RadzenColumnSeries>
                </RadzenChart>
            </Div>

            <!-- CARD 6 -->
            <Div Class="dashboard-card">
                <Div Class="card-header">
                    Cantidad total de indicadores del grupo por carrera
                </Div>

                <RadzenChart Style="height:260px;">
                    <RadzenColumnSeries Data="@totalIndicadoresGrupoPorCarreraData"
                                        CategoryProperty="Categoria"
                                        ValueProperty="Valor">
                        <RadzenSeriesDataLabels Visible="true" />
                    </RadzenColumnSeries>
                </RadzenChart>
            </Div>

        </Div>
    }
    else
    {
        <!-- Mensaje que aparece en caso de que los filtros no esten seleccionados correctamente y se presione el botón del formulario -->
        <Column>
            <p class="text-center greyText">Seleccione filtros y haga clic en "Buscar" para ver las gráficas.</p>
        </Column>
    }
    
</Container>

<!--Se llama al elemento .razor del footer en mayoría de las pantallas-->
<PruebaAutenticador2.Pages.ReusableComponents.Footer/>

<!-- Si los elementos todavía no se cargan, muestra la pantalla "cargando" -->
@if (isLoading)
{
    <Div Style="position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.4);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                z-index: 9999;">
        <Div Class="spinner-border text-white">
            <Span Class="visually-hidden">Cargando...</Span>
        </Div>
    </Div>
}

<!-- Modal para mostrar el mensaje de error -->
<Modal @ref="@modalToShowErrorMessage" Style="border-radius: 10px;">
    <ModalContent Centered="true">
        <ModalBody>
            <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">@errorMessage</Heading>
            <Button Style="font-family:IndivisaFont; background-color: #002855; color: #ffffff; margin-top: 10px;" Block="true" Clicked="() => HideModal(modalToShowErrorMessage)">
                Ok
            </Button>
        </ModalBody>
    </ModalContent>
</Modal>

@code {

    // Variables para filtros de búsqueda
    private bool graficasCargadas = false;
    private Guid? selectedGrupoId;
    private Guid? selectedPeriodoId;
    private Guid? selectedCarreraId;
    private Guid? selectedDirectrizId;

    // Lista completa de indicadores obtenida de la API
    private List<IndicadorDto> indicatorList = new();

    // Lista real filtrada
    private List<IndicadorDto> filteredIndicators = new();

    // Variable para controlar la visualización de la pantalla de carga
    private bool isLoading = false;

    // Variable para almacenar el mensaje de error
    private string? errorMessage;

    // Referencia al modal para mostrar el mensaje de error
    private Modal modalToShowErrorMessage;

    // Al iniciar la página, se cargan todos los indicadores desde la API para poder mostrar las opciones de filtros y generar las gráficas.
    protected override async Task OnInitializedAsync()
    {
        await LoadAllIndicators();
    }

    // Método para cargar todos los indicadores desde la API. 
    // Se muestra la pantalla de carga mientras se obtienen los datos. 
    // En caso de error, se muestra un mensaje indicando que no se pudo conectar con el servidor.
    private async Task LoadAllIndicators()
    {
        try 
        {
            isLoading = true;
            StateHasChanged();

            var response = await IndicadorApiService.GetAllAsync();

            indicatorList = response.Data!.ToList();

            filteredIndicators = indicatorList;

        }
        catch (Exception)
        {
            errorMessage = "No se pudo conectar con el servidor.";
            await modalToShowErrorMessage.Show();
        }
        finally
        {
            isLoading = false;
        }
    }

    // Método que se ejecuta al hacer clic en el botón "Buscar". Filtra la lista de indicadores según los filtros seleccionados y genera los datos para las gráficas.
    private void toSearchGraphics()
    {
        // Se verifica que los filtros de grupo, periodo y carrera estén seleccionados (no sean nulos ni Guid.Empty) 
        // para poder generar las gráficas. 
        // Si alguno de estos filtros no está seleccionado, no se generan las gráficas y se muestra el mensaje indicando que se deben seleccionar los filtros.
        if (selectedGrupoId != Guid.Empty &&
            selectedPeriodoId != Guid.Empty &&
            selectedCarreraId != Guid.Empty &&
            selectedDirectrizId != Guid.Empty)
        {
            filteredIndicators = indicatorList
             .Where(i =>
                 (!selectedGrupoId.HasValue || selectedGrupoId == Guid.Empty || i.GrupoId == selectedGrupoId) &&
                 (!selectedDirectrizId.HasValue || selectedDirectrizId == Guid.Empty || i.DirectrizId == selectedDirectrizId) &&
                 (!selectedPeriodoId.HasValue || selectedPeriodoId == Guid.Empty || i.PeriodoId == selectedPeriodoId) &&
                 (!selectedCarreraId.HasValue || selectedCarreraId == Guid.Empty || i.CarreraId == selectedCarreraId)
             )
             .ToList();

             //Gráfico 1
            totalIndicadoresPorGrupoData = filteredIndicators
            .GroupBy(i => i.Grupo)
            .Select(g => new BarData
            {
                Categoria = g.Key,
                Valor = g.Count()
            })
            .ToArray();

            //Gráfico 2
            var total = filteredIndicators.Count;
            var cumplidos = filteredIndicators.Count(i => i.FechaCumplimiento != null);
            var noCumplidos = total - cumplidos;

            cumplimientoData = new BarData[]
            {
                new BarData
                {
                    Categoria = "Cumplidos",
                    Valor = cumplidos
                },
                new BarData
                {
                    Categoria = "No cumplidos",
                    Valor = noCumplidos
                }
            };

            // Gráfico 3
            int porcentajeCumplido = total == 0 ? 0 : (int)((double)cumplidos / total * 100);
            int porcentajeRestante = 100 - porcentajeCumplido;

            porcentajeCumplimientoData = new PieData[]
            {
                new PieData
                {
                    Categoria = "Cumplido %",
                    Valor = porcentajeCumplido
                },
                new PieData
                {
                    Categoria = "No cumplido %",
                    Valor = porcentajeRestante
                }
            };

            //Gráfico 4
            totalIndicadoresGrupoPorDirectrizData = filteredIndicators
            .GroupBy(i => i.Directriz)
            .Select(g => new BarData
            {
                Categoria = g.Key,
                Valor = g.Count()
            })
            .ToArray();

            //Gráfico 5
            totalIndicadoresGrupoPorPeriodoData = filteredIndicators
            .GroupBy(i => i.Periodo)
            .Select(g => new BarData
            {
                Categoria = g.Key,
                Valor = g.Count()
            })
            .ToArray();

            //Gráfico 6
            totalIndicadoresGrupoPorCarreraData = filteredIndicators
            .GroupBy(i => i.Carrera)
            .Select(g => new BarData
            {
                Categoria = g.Key,
                Valor = g.Count()
            })
            .ToArray();

            graficasCargadas = true;
        }
        else
        {
            graficasCargadas = false;
        }
    }

    // Método para ocultar el modal de mensaje de error
    private Task HideModal(Modal modal)
    {
        return modal.Hide();
    }

    // Variable para controlar la visualización de las etiquetas de datos en las gráficas
    bool showDataLabels = true;

    // Clases para representar los datos de las gráficas (categoría y valor), dependiendo si es de tipo pie o barra
    class PieData
    {
        public string Categoria { get; set; }
        public int Valor { get; set; }
    }

    // Variable para almacenar los datos del gráfico pastel de porcentaje de cumplimiento
    private PieData[] porcentajeCumplimientoData;

    class BarData
    {
        public string Categoria { get; set; }
        public int Valor { get; set; }
    }

    // Variables para almacenar los datos de las gráficas de barras
    private BarData[] totalIndicadoresPorGrupoData;
    private BarData[] cumplimientoData;
    private BarData[] totalIndicadoresGrupoPorDirectrizData;
    private BarData[] totalIndicadoresGrupoPorPeriodoData;
    private BarData[] totalIndicadoresGrupoPorCarreraData;

}
