<!-- Estructura princial del SurveyPrompt (es probable que se pueda borrar, pero por si acaso no hacerlo). -->
<div class="alert alert-secondary mt-4">
    <span class="oi oi-pencil me-2" aria-hidden="true"></span>
    <strong>@Title</strong>

    <span class="text-nowrap">
        Please take our
        <a target="_blank" class="font-weight-bold link-dark" href="https://go.microsoft.com/fwlink/?linkid=2186158">brief survey</a>
    </span>
    and tell us what you think.
</div>

@code {
    // Propiedad para el título del mensaje, que se puede establecer al usar el componente en otras partes de la aplicación y que se muestra en el mensaje de alerta.
    [Parameter]
    public string? Title { get; set; }
}
