<!-- Importaciones de librerías/servicios. -->
@using PruebaAutenticador2.Services
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject TokenStorageService TokenStorage
@inject AuthStateService AuthState
@inject TokenWatcherService TokenWatcher
@implements IDisposable

<!-- Importaciones de componentes de Radzen. -->
<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<RadzenComponents />

<!-- Importaciones de estilo CSS. -->
<link rel="stylesheet" href="css/Fonts.css" />

<!-- Estructura principal del layout, con un ErrorBoundary para manejar errores inesperados y un modal para mostrar el mensaje de sesión expirada. --> 
<!-- Actualmente, cuando surge un error inesperado de renderizado, muestra una pantalla en blanco, pero se cuentan con excepciones controladas para no usar este componente y no arruinar la experiencia del usuario. -->
<div class="page" style="overflow-x: hidden;">
    <main>
        <article>
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    <div id="blazor-error-ui">
                        <p>Ocurrió un error inesperado. Por favor, recargue la página</p>
                        <p>@exception.Message</p>
                        <button class="oi-reload" @onclick="Reload">
                            Recargar página
                        </button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<!-- Modal para mostrar el mensaje de sesión expirada. -->
@if (showSessionExpireModal)
{
    <Modal @ref="@modalToShowTokenExpired" Style="border-radius: 10px;">
        <ModalContent Centered="true">
            <ModalBody>
                <Heading Size="HeadingSize.Is5" Style="text-align:center; font-family:IndivisaFont; color: #002855;">Tu sesión ha caducado y en unos segundos volverás a la pantalla de iniciar sesión.</Heading>
            </ModalBody>
        </ModalContent>
    </Modal>
}

@code {
    // Variable para controlar la visibilidad del modal de sesión expirada.
    private bool showSessionExpireModal = false;

    // Referencia al ErrorBoundary para poder recargar la página en caso de error.
    private ErrorBoundary? errorBoundary;

    // Referencia al Modal para mostrar el mensaje de sesión expirada.
    private Modal? modalToShowTokenExpired;

    // Método para recargar la página en caso de error.
    private void Reload()
    {
        errorBoundary?.Recover();
        Navigation.NavigateTo(Navigation.Uri, true);
    }

    // Método para inicializar el componente, cargando el token desde el almacenamiento y configurando el estado de autenticación.
    protected override async Task OnInitializedAsync()
    {
        var token = await TokenStorage.GetTokenAsync();

        if (!string.IsNullOrEmpty(token))
        {
            AuthState.SetToken(token);
        }
    }

    // Método para iniciar el TokenWatcher y suscribirse al evento de token expirado.
    protected override void OnInitialized()
    {
        TokenWatcher.Start();

        TokenWatcher.OnTokenExpired += HandleTokenExpired;
    }

    // Método para manejar el evento de token expirado, mostrando un modal y redirigiendo al usuario a la pantalla de inicio de sesión después de unos segundos.
    private void HandleTokenExpired()
    {
        InvokeAsync(() =>
        {
            showSessionExpireModal = true;
            StateHasChanged();
        });

        modalToShowTokenExpired?.Show();

        Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() => Navigation.NavigateTo("/MicrosoftIdentity/Account/SignOut", true));
        });
    }

    // Método para limpiar la suscripción al evento de token expirado cuando el componente se destruye.
    public void Dispose()
    {
        TokenWatcher.OnTokenExpired -= HandleTokenExpired;
    }
}




