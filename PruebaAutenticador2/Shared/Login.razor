<!-- Importaciones de librerías/servicios. -->
@inject NavigationManager Nav

<!-- Importaciones de estilos CSS. -->
<link rel="stylesheet" href="css/Custom-button-login.css" />

<!-- Botón para iniciar sesión con el servicio de microsoft. -->
<AuthorizeView>
    <NotAuthorized>
        <Button Class="custom-button-login" Clicked="LogIn">Iniciar sesión</Button>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Método para iniciar sesión.
    private void LogIn()
    {
        // Redirige a la ruta de inicio de sesión de Microsoft (importante que dentro del NavigateTo este el valor True en el forcedLoad para que funcione el inicio de sesión correctamente).
        Nav.NavigateTo("MicrosoftIdentity/Account/SignIn", true);
    }
}
