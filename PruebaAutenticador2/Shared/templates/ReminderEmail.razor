<link rel="stylesheet" href="css/Fonts.css" />

<Div Style="width:100%; font-family: IndivisaFont; background-color:#f9fafb; padding:20px;">
    <Row>
        <Column>
            <Div Style="max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.1); padding:30px;">

                <!-- Encabezado -->
                <Div Style="border-bottom:2px solid #002855; padding-bottom:10px; text-align: center; color:#002855; margin:0; font-size: 26px;">
                      📩 Recordatorio
                </Div>

                <!-- Cuerpo -->
                <Div Style="padding-top:10px; color:#002855;">
                    <Paragraph Style="font-size:16px; text-align: left;">
                        Este correo fue enviado automáticamente desde la aplicación de <Strong>Gestión de Indicadores</Strong> de la universidad La Salle Bajío.
                    </Paragraph>
                    <Div Style="background-color:#f3f4f6; padding:15px; border-radius:8px; margin-top:15px; margin-bottom: 15px;">
                        <Paragraph Style="margin:0; font-size:16px; text-align:left;">
                            <Strong>📅 Fecha programada:</Strong> {{FECHA}}<br />
                            <Strong>⏰ Hora programada:</Strong> {{HORA}}
                        </Paragraph>
                    </Div>
                    <Paragraph Style="font-size:14px; color:#6b7280; text-align: left; margin-bottom: 15px;">
                        Si no esperabas este correo, puedes ignorarlo con seguridad.
                    </Paragraph>
                </Div>

                <!-- Footer -->
                <Div Style="padding-top:20px; border-top:2px solid #e5e7eb; margin-top:15px;">
                    <Paragraph Style="font-size:14px; color:#9ca3af; text-align: left;">
                        © {{ANIO}} Gestión de Indicadores | Universidad La Salle Bajío
                    </Paragraph>
                </Div>

            </Div>
        </Column>
    </Row>
</Div>
