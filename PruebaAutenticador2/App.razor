<!-- Importaciones de librerías/servicios. -->
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Routing
@using PruebaAutenticador2.Services
@using PruebaAutenticador2.Shared
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthStateService AuthState
@inject TokenStorageService tokenStorageService

<!-- Importaciones de estilos CSS. -->
<link rel="stylesheet" href="css/Fonts.css" />
<link rel="stylesheet" href="css/NotFoundElement.css" />

<!-- Estrctura principal de App (componente usado en MainLayout). Se actualizo la interfaz para mostrar el mensaje de "elemento o ruta no encontrado" de manera amigable. -->
<!-- Los estilos y la estructura mostrados son los mismo que en la pantalla NotFoundUser.razor y NotFoundRole.razor. -->
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        </Found>
        <NotFound>
            <PageTitle>No encontrado</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <Container Class="container-error">
                    <Card Class="error-card shadow">
                        <CardHeader Class="error-header bg-indivisa-blue text-white">
                            <Icon Name="IconName.Alert" Size="IconSize.ExtraLarge" Class="error-icon" />
                            <Heading Size="HeadingSize.Is5" Style="font-family:IndivisaFontBold;">ELEMENTO O RUTA NO ENCONTRADO</Heading>
                        </CardHeader>
                        <CardBody>
                            <Heading Size="HeadingSize.Is6" Style="font-family:IndivisaFont;">POSIBLES CAUSAS:</Heading>
                            <ListGroup Class="error-list">
                                <ListGroupItem Style="font-family:IndivisaFont;">
                                    <Icon Name="IconName.Circle" Class="error-list-icon" />
                                    LA RUTA NO EXISTE.
                                </ListGroupItem>
                                <ListGroupItem Style="font-family:IndivisaFont;">
                                    <Icon Name="IconName.Circle" Class="error-list-icon" />
                                    RUTA MAL ESCRITA.
                                </ListGroupItem>
                            </ListGroup>
                        </CardBody>
                        <CardFooter Class="error-footer text-center">
                            <Paragraph Style="font-family:IndivisaFont;">UNIVERSIDAD LA SALLE BAJÍO. TODOS LOS DERECHOS RESERVADOS © @DateTime.Now.Year. </Paragraph>
                        </CardFooter>
                    </Card>
                </Container>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    // Referencia al objeto de la aplicación para poder ser llamado desde JavaScript.
    DotNetObjectReference<App>? objRef;

    // Método para limpiar la referencia al objeto de la aplicación cuando el componente se destruye, evitando posibles fugas de memoria.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Solo se ejecuta la lógica de registro del listener en el primer renderizado del componente, evitando múltiples registros si el componente se vuelve a renderizar por alguna razón.
        if (!firstRender) return;

        // Crear una referencia al objeto de la aplicación para que pueda ser llamado desde JavaScript.
        objRef = DotNetObjectReference.Create(this);

        // Registrar el listener de almacenamiento en JavaScript, pasando la referencia al objeto de la aplicación para que pueda llamar al método OnTokenRemoved cuando se detecte un cambio en el almacenamiento.
        await JS.InvokeVoidAsync("authStorageListener", objRef);
    }

    // Método que se llama desde JavaScript cuando se detecta que el token ha sido eliminado del almacenamiento (por ejemplo, en otra pestaña del navegador), para cerrar sesión en la aplicación actual y redirigir al usuario a la pantalla de inicio de sesión.
    [JSInvokable]
    public async Task OnTokenRemoved()
    {
        await tokenStorageService.RemoveTokenAsync();
        AuthState.Logout();
        Nav.NavigateTo("/MicrosoftIdentity/Account/SignOut", true);
        await Task.CompletedTask; // Método completado, no se necesita realizar ninguna acción adicional después de cerrar sesión y redirigir al usuario.
    }

    // Método para regresar a la pantalla de inicio.
    private void GoBack()
    {
        Nav.NavigateTo("/home");
    }
}
